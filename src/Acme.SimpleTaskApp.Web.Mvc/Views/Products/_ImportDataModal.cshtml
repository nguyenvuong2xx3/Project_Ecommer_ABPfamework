@using Abp.Json
@using Abp.UI.Inputs
@using Acme.SimpleTaskApp.Web.Models.Common.Modals

<style>
  .modal-dialog {
    margin-top: 65px !important;
  }
</style>
@section scripts
{
  <environment names="Development">
    <script src="~/Common/Scripts/bootstrap-filestyle.js" asp-append-version="true"></script>
  </environment>
}
@await Html.PartialAsync("~/Views/Shared/Modals/_ModalHeader.cshtml", new ModalHeaderViewModel("Nhập dữ liệu dữ liệu"))


<div class="modal-body" id="CreateProductUnitForm">
  <form name="ImportProductUnitForm">
    <div class="col-12 mb-3">
      <div class="form-group ">
        <label for="ImportData" class="form-label label text-secondary">@(new FixedLocalizableString("Tệp excel"))</label> <span class="text-danger">*</span>
        <div id="ImportFileDataUploadArea" class="file-uploaded-area">
        </div>
        <div class="d-flex ms-sm-3 ms-md-0 fileinput-custom input-group">
          <input id="ImportFileData" type="file" name="files" accept=".json, .xlsx, .xls" required>
        </div>
      </div>
    </div>
    <div id="ResultNotificationArea">
    </div>
  </form>
</div>

@await Html.PartialAsync("~/Views/Shared/Modals/_ModalFooterWithSaveAndCancel.cshtml")


