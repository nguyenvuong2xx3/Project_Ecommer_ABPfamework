@using Acme.SimpleTaskApp.Web.Models.HomeCustomers
@using System.Linq

@model HomeCustomerViewModel

@{
  ViewData["Title"] = "Detail";
  Layout = "~/Views/Shared/Layout/Customer/_LayoutCustomer.cshtml";

  // Lấy danh sách storage duy nhất
  var uniqueStorages = Model.ProductInfo.ProductVariants
      .Select(pv => pv.Storage)
      .Distinct()
      .ToList();
}
<link href="~/css/style.css" rel="stylesheet" />

@section scripts
{
  <environment names="Development">
    <!-- SignalR Client Library -->
    <script src="https://cdn.jsdelivr.net/npm/@@microsoft/signalr@@7.0.0/dist/browser/signalr.min.js"></script>
    
    <script src="~/view-resources/Views/Carts/index.js" asp-append-version="true"></script>
    <script src="~/view-resources/Views/HomeCustomer/DetailProductHomeCustomer.js" asp-append-version="true"></script>
    <script src="~/view-resources/Views/Shared/Components/ProductComments/_ProductComments.js" asp-append-version="true"></script>
    <script src="~/view-resources/Views/Shared/Components/ProductRatings/_ProductRatings.js" asp-append-version="true"></script>
  </environment>
}

<div class="container-fluid py-3" style="padding: 0 200px">
  <div class="bg-white p-3 mb-3 rounded">
    <div class="row align-items-center">
      <div class="col">
        <h1 class="h4 fw-bold mb-2">
          @Model.ProductInfo.Name @Model.ProductInfo.ProductVariant.Ram @Model.ProductInfo.ProductVariant.Storage @Model.ProductInfo.ProductVariant.Color
        </h1>
      </div>
    </div>
  </div>

  <div class="d-flex flex-wrap">
    <div class="col-lg-8">
      <div class="bg-white p-3 rounded">
        <div id="productImageCarousel" class="carousel slide" data-bs-ride="false" style="height: 400px;">
          @{
            var allImageUrls = new List<string>();
            if (Model.ProductInfo.ImageUrls != null)
            {
              allImageUrls.AddRange(Model.ProductInfo.ImageUrls);
            }
            if (Model.ProductInfo.ProductVariant?.ImageUrls != null)
            {
              allImageUrls.AddRange(Model.ProductInfo.ProductVariant.ImageUrls);
            }
            if (!allImageUrls.Any())
            {
              allImageUrls.Add("/img/products/default.png");
            }
          }

          <div class="carousel-indicators">
            @for (int i = 0; i < allImageUrls.Count; i++)
            {
              <button type="button"
                      data-bs-target="#productImageCarousel"
                      data-bs-slide-to="@i"
                      class="@(i == 0 ? "active" : "")"
                      aria-current="@(i == 0 ? "true" : "false")"
                      aria-label="Slide @(i + 1)"></button>
            }
          </div>

          <div class="carousel-inner h-100">
            @for (int j = 0; j < allImageUrls.Count; j++)
            {
              <div class="carousel-item @(j == 0 ? "active" : "") h-100">
                <img src="@allImageUrls[j]"
                     class="d-block w-100 h-100 object-fit-contain"
                     alt="Product Image @(j + 1)"
                     onerror="this.style.display='none'">
              </div>
            }
          </div>


          <button class="carousel-control-prev" type="button" data-bs-target="#productImageCarousel" data-bs-slide="prev">
            <span class="carousel-control-prev-icon" aria-hidden="true"></span>
            <span class="visually-hidden">Previous</span>
          </button>
          <button class="carousel-control-next" type="button" data-bs-target="#productImageCarousel" data-bs-slide="next">
            <span class="carousel-control-next-icon" aria-hidden="true"></span>
            <span class="visually-hidden">Next</span>
          </button>
        </div>

        <div class="d-flex gap-2 mb-3 flex-wrap justify-content-center pt-3">
          @foreach (var imgpd in Model.ProductInfo.ProductVariants)
          {
            var isActive = Model.ProductInfo.ProductVariant.Id == imgpd.Id;

            <div class="variant-item d-flex flex-column align-items-center me-2"
                 style="margin-right: 10px; cursor: pointer;"
                 data-variant-id="@imgpd.Id">
              <div class="color-option border border-2 rounded-3 d-flex justify-content-center align-items-center @(isActive ? "border-primary shadow" : "border-secondary")"
                   style="width: 60px; height: 60px; overflow: hidden; border-radius: 10px;">
                <img src="@imgpd.ImageUrls.First()" style="width: 100%; height: 100%; object-fit: cover; display: block;">
              </div>
              <span class="small mt-1 text-center">@imgpd.Color</span>
            </div>
          }
        </div>
      </div>

      <!-- Thêm phần thông số kỹ thuật -->
      <div class="bg-white p-3 rounded mt-3">
        <h4 class="fw-bold mb-3">Thông số kỹ thuật</h4>
        <div class="row">
          <div class="col-md-6">
            <table class="table table-striped">
              <tbody>
                <tr>
                  <td class="fw-semibold">Màn hình:</td>
                  <td>@Model.ProductInfo.Screen</td>
                </tr>
                <tr>
                  <td class="fw-semibold">Chip xử lý:</td>
                  <td>@Model.ProductInfo.Processor</td>
                </tr>
                <tr>
                  <td class="fw-semibold">Hệ thống camera:</td>
                  <td>@Model.ProductInfo.CameraSystem</td>
                </tr>
                <tr>
                  <td class="fw-semibold">RAM:</td>
                  <td>@Model.ProductInfo.ProductVariant.Ram</td>
                </tr>
              </tbody>
            </table>
          </div>
          <div class="col-md-6">
            <table class="table table-striped">
              <tbody>
                <tr>
                  <td class="fw-semibold">Dung lượng lưu trữ:</td>
                  <td>@Model.ProductInfo.ProductVariant.Storage</td>
                </tr>
                <tr>
                  <td class="fw-semibold">Pin:</td>
                  <td>@Model.ProductInfo.Battery</td>
                </tr>
                <tr>
                  <td class="fw-semibold">Màu sắc:</td>
                  <td>@Model.ProductInfo.ProductVariant.Color</td>
                </tr>
              </tbody>
            </table>
          </div>
        </div>

        <!-- Mô tả sản phẩm -->
        @if (!string.IsNullOrEmpty(Model.ProductInfo.Description))
        {
          <div class="mt-4">
            <h5 class="fw-bold mb-2">Mô tả sản phẩm</h5>
            <p class="text-muted">@Model.ProductInfo.Description</p>
          </div>
        }
      </div>

      <!-- COMMENT SECTION - THÊM MỚI -->
      @await Html.PartialAsync("Components/ProductComments/_ProductComments", ViewBag.ProductComments as List<Acme.SimpleTaskApp.ProductComments.Dtos.ProductCommentDto>)

      <!-- RATING SECTION -->
      @await Html.PartialAsync("Components/ProductRatings/_ProductRatings", ViewBag.ProductRatings as List<Acme.SimpleTaskApp.ProductRatings.Dtos.ProductRatingDto>)
    </div>

    <!-- Right Side - Purchase Options -->
    <div class="col-lg-4">
      <div class="bg-white p-3 rounded" style="top: 20px;">

        <!-- Price Section -->
        <div class="mb-3 p-3 rounded">
          @if (Model.ProductInfo.ProductVariant.HasActiveDiscount && Model.ProductInfo.ProductVariant.DiscountPercentage > 0)
          {
            <div class="text-muted text-decoration-line-through mb-1">
              Giá gốc: @Model.ProductInfo.ProductVariant.Price.ToString("#,##0")₫
            </div>
            <div class="h3 text-danger mb-0">
              @Model.ProductInfo.ProductVariant.DiscountedPrice.ToString("#,##0")₫
            </div>
            <small class="text-success">
              <i class="fas fa-tag"></i> Tiết kiệm @((Model.ProductInfo.ProductVariant.Price - Model.ProductInfo.ProductVariant.DiscountedPrice).ToString("#,##0"))₫
            </small>
          }
          else
          {
            <div class="h3 text-danger mb-0">
              @Model.ProductInfo.ProductVariant.Price.ToString("#,##0")₫
            </div>
          }
        </div>

        <!-- Storage Options -->
        <div class="mb-3">
          <label class="form-label fw-semibold">Bộ nhớ:</label>
          <div class="btn-group" role="group" style="width: auto;">
            @foreach (var storage in uniqueStorages)
            {
              // Tìm variant đầu tiên có storage này để lấy ID
              var firstVariantWithStorage = Model.ProductInfo.ProductVariants
              .FirstOrDefault(pv => pv.Storage == storage);

              if (firstVariantWithStorage != null)
              {
                var isActive = Model.ProductInfo.ProductVariant.Storage == storage;
                <label class="btn btn-outline-primary @(isActive ? "active" : "")"
                       style="margin-right: 10px; border-radius: 10px; cursor: pointer;"
                       data-variant-id="@firstVariantWithStorage.Id">
                  @storage
                </label>
              }
            }
          </div>
        </div>

        <!-- Color Options -->
        <div class="mb-3">
          <label class="form-label fw-semibold">Màu sắc:</label>
          <div class="row">
            @{
              int colorIndex = 0;
              foreach (var imgpd in Model.ProductInfo.ProductVariants)
              {
                var isActive = imgpd.Id == Model.ProductInfo.ProductVariant.Id;
                <div class="col-6 mb-2">
                  <div class="color-option border border-2 rounded-3 p-2 d-flex align-items-center position-relative @(isActive ? "border-primary shadow-sm" : "border-secondary-subtle")"
                       style="border-radius: 10px; cursor: pointer;"
                       data-variant-id="@imgpd.Id">

                    @* Discount badge on variant *@
                    @if (imgpd.HasActiveDiscount && imgpd.DiscountPercentage > 0)
                    {
                      <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger" style="font-size: 0.65rem;">
                        -@imgpd.DiscountPercentage.ToString("0")%
                      </span>
                    }

                    <!-- Ảnh bên trái -->
                    <img src="@imgpd.ImageUrls.First()"
                         style="height: 45px; width: 45px; object-fit: contain; border-radius: 5px; margin-right: 10px">

                    <!-- Thông tin bên phải -->
                    <div class="ms-2 d-flex flex-column align-items-start">
                      <span class="small fw-semibold">@imgpd.Color</span>
                      @if (imgpd.HasActiveDiscount && imgpd.DiscountPercentage > 0)
                      {
                        <span class="small text-muted text-decoration-line-through">@imgpd.Price.ToString("#,##0")₫</span>
                        <span class="small text-danger fw-bold">@imgpd.DiscountedPrice.ToString("#,##0")₫</span>
                      }
                      else
                      {
                        <span class="small text-muted">@imgpd.Price.ToString("#,##0")₫</span>
                      }
                    </div>
                  </div>
                </div>
                colorIndex++;
              }
            }
          </div>
        </div>

        <!-- Payment Options -->
        <div class="mb-3">
          <div class="d-grid gap-2 mb-3">
            <button class="btn btn-outline-primary btn-lg add-to-cart" @(Model.ProductInfo.ProductVariant.StockQuantity == 0 ? "disabled" : "")>
              <i class="bi bi-cart-plus"></i> Thêm vào giỏ
            </button>
            <button class="btn btn-warning btn-lg text-white fw-bold add-buy" @(Model.ProductInfo.ProductVariant.StockQuantity == 0 ? "disabled" : "")>
              Mua ngay
            </button>
          </div>
        </div>

        <!-- Contact Info -->
        <div class="text-center">
          <p class="mb-1">
            <i class="bi bi-telephone"></i> Gọi đặt mua
            <a href="tel:1900232460" class="text-primary">1900 232 460</a>
            <span class="text-muted small">(8:00 - 21:30)</span>
          </p>
          <a href="#" class="text-primary text-decoration-none small">
            <i class="bi bi-box-seam"></i> Xem siêu thị có hàng
          </a>
        </div>
      </div>
      @await Component.InvokeAsync("Banners", new { viewName = "BannerDetailMiddle" })

    </div>
    @await Component.InvokeAsync("ProductList", new { viewName = "FilterCategory", categoryId = @Model.ProductInfo.CategoryId })
  </div>
</div>