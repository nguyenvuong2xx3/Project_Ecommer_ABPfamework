@using Acme.SimpleTaskApp.Web.Models.HomeCustomers

@model HomeCustomerViewModel

@{
  ViewData["Title"] = "Detail";
  Layout = "~/Views/Shared/Layout/Customer/_LayoutCustomer.cshtml";
}
<link href="~/css/style.css" rel="stylesheet" />
@section scripts
{
  <environment names="Development">
    <script src="~/view-resources/Views/Carts/index.js" asp-append-version="true"></script>
    <script src="~/view-resources/Views/HomeCustomer/DetailProductHomeCustomer.js" asp-append-version="true"></script>
  </environment>
}
<div class="container-fluid py-3" style="padding: 0 390px">
  <div class="bg-white p-3 mb-3 rounded">
    <div class="row align-items-center">
      <div class="col">
        <h1 class="h4 fw-bold mb-2">
          @Model.ProductInfo.Name @Model.ProductInfo.ProductVariant.Ram @Model.ProductInfo.ProductVariant.Storage @Model.ProductInfo.ProductVariant.Color
        </h1>
      </div>
    </div>
  </div>

  <div class="d-flex flex-wrap">
    <div class="col-lg-8">
      <div class="bg-white p-3 rounded">
        <div class="main-image-container position-relative rounded overflow-hidden mb-3 d-flex justify-content-center align-items-center bg-light"
             style="height: 400px;">
          <img src="@Model.ProductInfo.ImageUrls.First()"
               class="img-fluid h-100 w-auto object-fit-contain"
               alt="iPhone 17">

          <button class="gallery-nav btn btn-light rounded-circle position-absolute start-0 ms-2">
            <i class="bi bi-chevron-left"></i>
          </button>
          <button class="gallery-nav btn btn-light rounded-circle position-absolute end-0 me-2">
            <i class="bi bi-chevron-right"></i>
          </button>
        </div>

        <div class="d-flex gap-2 mb-3 flex-wrap justify-content-center">
          @foreach (var imgpd in Model.ProductInfo.ProductVariants)
          {
            foreach (var img in imgpd.ImageUrls)
            {
              <div class="color-option border border-2 rounded p-2 text-center d-flex flex-column align-items-center"
                   style="width: 60px; margin-right: 10px; border-radius: 7px;">
                <img src="@img" style="height: 45px; object-fit: contain;">
                <span class="small mt-1">@imgpd.Color</span>
              </div>
            }
          }
        </div>
      </div>
    </div>

    <!-- Right Side - Purchase Options -->
    <div class="col-lg-4">
      <div class="bg-white p-3 rounded" style="top: 20px;">
        <!-- Storage Options -->
        <div class="mb-3">
          <div class="btn-group" role="group" style="width: 75px">
            @foreach (var item in Model.ProductInfo.ProductVariants)
            {
              <label class="btn btn-outline-primary" for="storage1">@item.Storage</label>
            }
          </div>
        </div>
        <!-- Color Options -->
        <div class="mb-3">
          <div class="d-flex gap-3 mb-3 flex-wrap justify-content-center">
            @foreach (var imgpd in Model.ProductInfo.ProductVariants)
            {
              foreach (var img in imgpd.ImageUrls)
              {
                <div class="color-option border border-2 rounded-3 p-2 d-flex align-items-center"
                     style="min-width: 150px; border-radius: 10px; margin-right: 10px">
                  <!-- Ảnh bên trái -->
                  <img src="@img" style="height: 45px; width: 45px; object-fit: contain; border-radius: 5px; margin-right: 10px">

                  <!-- Thông tin bên phải -->
                  <div class="ms-2 d-flex flex-column align-items-start">
                    <span class="small fw-semibold">@imgpd.Color</span>
                    <span class="small text-muted">@imgpd.Price.ToString("#,##0")₫</span>
                  </div>
                </div>
              }
            }
          </div>
        </div>

        <!-- Payment Options -->
        <div class="mb-3">
          <div class="d-grid gap-2 mb-3">
            <button class="btn btn-outline-primary btn-lg add-to-cart">
              <i class="bi bi-cart-plus"></i> Thêm vào giỏ
            </button>
            <button class="btn btn-warning btn-lg text-white fw-bold">
              Mua ngay
            </button>
          </div>
        </div>

        <!-- Contact Info -->
        <div class="text-center">
          <p class="mb-1">
            <i class="bi bi-telephone"></i> Gọi đặt mua
            <a href="tel:1900232460" class="text-primary">1900 232 460</a>
            <span class="text-muted small">(8:00 - 21:30)</span>
          </p>
          <a href="#" class="text-primary text-decoration-none small">
            <i class="bi bi-box-seam"></i> Xem siêu thị có hàng
          </a>
        </div>
      </div>
    </div>
  </div>
</div>
