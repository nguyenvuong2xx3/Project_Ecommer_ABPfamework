@model Acme.SimpleTaskApp.Web.Models.Carts.CartViewModel

@{
  ViewData["Title"] = "Cart";
  Layout = "~/Views/Shared/Layout/Customer/_LayoutCustomer.cshtml";
}

@section scripts
{
  <script src="~/Common/Scripts/vnpay-helper.js" asp-append-version="true"></script>
  <environment names="Development">
    <script src="~/view-resources/Views/Carts/index.js" asp-append-version="true"></script>
  </environment>
  
  @* Show payment error notification if exists *@
  @if (TempData["PaymentError"] != null)
  {
    <script>
      $(function() {
        abp.notify.error('@TempData["PaymentError"]' + 
          @if (TempData["PaymentMessage"] != null) { <text> + '\n' + '@TempData["PaymentMessage"]'</text> });
      });
    </script>
  }
}

@{
  decimal total = 0;
}

<div class="container-fluid py-5">
  <div class="container py-5" style="padding-top: 100px !important; background-color: rgb(255, 255, 255);
        box-shadow: rgba(0, 0, 0, 0.1) 0px 4px 8px;">

    @* Hiển thị thông báo lỗi thanh toán nếu có *@
    @if (TempData["PaymentError"] != null)
    {
      <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <i class="fas fa-exclamation-triangle me-2"></i>
        <strong>@TempData["PaymentError"]</strong>
        @if (TempData["PaymentMessage"] != null)
        {
          <br />
          <span>@TempData["PaymentMessage"]</span>
        }
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
      </div>
    }

    @* Trường hợp chưa đăng nhập *@
    @if (Model == null)
    {
      <h2 class="text-center text-muted">@ViewBag.Message</h2>
    }
    else if (Model.CartItems == null || !Model.CartItems.Any())
    {
      @* Trường hợp giỏ hàng rỗng *@
      <h2 class="text-center text-muted">Chưa có sản phẩm trong giỏ hàng</h2>
    }
    else
    {
      @* Trường hợp có sản phẩm *@
      <div class="row">
        <div class="col-lg-8">
          @foreach (var product in Model.CartItems)
          {
            <div class="card mb-4 border-0 shadow-sm cart-item">
              <div class="card-body">
                <div class="row align-items-center">
                  <div class="col-md-2">
                    <img src="@product.ImageUrl" class="img-fluid rounded" alt="@product.Name">
                  </div>
                  <div class="col-md-6">
                    <h5 class="card-title">@product.Name</h5>
                    <p class="text-muted mb-1">Màu: Titan tự nhiên</p>
                    <div class="d-flex align-items-center mt-3">
                      <div class="input-group quantity" style="width: 130px;">
                        <div class="input-group-btn">
                          <button class="btn btn-sm btn-minus rounded-circle bg-light border btl-click-minus"
                                  data-productvariant-id="@product.IdProductVariant" data-productvariant-cartid="@product.IdCart">
                            <i class="fa fa-minus"></i>
                          </button>
                        </div>
                        <input type="text" class="form-control form-control-sm text-center border-0"
                               value="@product.Quantity" id="quantity-@product.IdProductVariant" readonly>
                        <div class="input-group-btn">
                          <button class="btn btn-sm btn-plus rounded-circle bg-light border btl-click-plus"
                                  data-productvariant-id="@product.IdProductVariant" data-productvariant-cartid="@product.IdCart"
                                  data-product-id="@product.ProductId" data-category-id="@product.CategoryId">
                            <i class="fa fa-plus"></i>
                          </button>
                        </div>
                      </div>
                      <button class="btn btn-link text-danger ms-3 btl-click-delete"
                              data-productvariant-id="@product.IdProductVariant" data-productvariant-cartid="@product.IdCart">
                        <i class="fa fa-trash me-1"></i>Xóa
                      </button>
                    </div>
                  </div>
                  <div class="col-md-4 text-end">
                    <div class="d-flex flex-column">
                      <div class="d-flex justify-content-between align-items-center mb-2">
                        @if (product.HasActiveDiscount)
                        {
                          <span class="text-muted text-decoration-line-through">@product.Price.ToString("N0")đ</span>
                          <h4 class="text-primary mb-0">@product.DiscountedPrice.ToString("N0")đ</h4>
                          total += product.DiscountedPrice * product.Quantity;
                        }
                        else
                        {
                          <h4 class="text-primary mb-0">@product.Price.ToString("N0")đ</h4>
                          total += product.Price * product.Quantity;
                        }
                      </div>
                      @if (product.HasActiveDiscount)
                      {
                        <div class="mb-3">
                          <span class="badge bg-success">Giảm @product.DiscountPercentage%</span>
                        </div>
                      }
                    </div>
                  </div>
                </div>
              </div>
            </div>
          }

          @* Phần mua kèm giảm giá *@
          @* <div class="card border-0 shadow-sm mb-4">
            <div class="card-body">
              <h5 class="card-title">Mua kèm giảm đến 10%</h5>
              <div class="d-flex align-items-center">
                <div class="form-check">
                  <input class="form-check-input" type="checkbox" id="addAccessory">
                  <label class="form-check-label" for="addAccessory">
                    Ốp lưng điện thoại
                  </label>
                </div>
                <span class="ms-auto text-primary fw-bold">+ 250.000đ</span>
              </div>
            </div>
          </div> *@
        </div>

        @* Phần thông tin đơn hàng *@
        <div class="col-lg-4">
          @* Thông tin người nhận *@
          <div class="card border-0 shadow-sm mb-4">
            <div class="card-header bg-light">
              <h5 class="mb-0">Thông tin nhận hàng</h5>
            </div>
            <div class="card-body">
              <div class="d-flex align-items-start mb-3">
                <i class="fa fa-user me-3 mt-1 text-primary"></i>
                <div class="flex-grow-1">
                  @if (Model.User.Name == null || Model.User.Surname == null || Model.User.TinhThanh == null || Model.User.PhuongXa == null)
                  {
                    <div class="alert alert-warning" role="alert">
                      Vui lòng cập nhật đầy đủ thông tin nhận hàng để tiếp tục đặt hàng.
                    </div>
                  }
                  else
                  {
                    <h6 class="mb-1" id="FullName">@($"{Model.User.Name} {Model.User.Surname}")</h6>
                    <p class="text-muted small mb-2" id="PhoneNumber">@Model.User.PhoneNumber</p>
                    <p class="text-muted small mb-0" id="DiaChi">@($"{Model.User.DiaChiChiTiet},{Model.PhuongXa}, {Model.TinhThanh}")</p>
                  }
                </div>
              </div>
              <button class="btn btn-outline-primary w-100" id="OrderInfoButton">
                <i class="fa fa-edit me-2"></i>Thay đổi địa chỉ
              </button>
            </div>
          </div>

          @* Phần tổng đơn hàng *@
          <div class="card border-0 shadow-sm sticky-top" style="top: 120px;">

            <div class="voucher-section mb-4 p-3 rounded">
              <h6 class="mb-3">
                <i class="fas fa-ticket-alt text-primary"></i> Mã giảm giá
              </h6>
              <div class="input-group">
                <input type="text"
                       id="voucherCodeInput"
                       class="form-control"
                       placeholder="Nhập mã voucher"
                       >
                <button class="btn btn-primary" type="button" id="applyVoucherBtn">
                  <i class="fas fa-check"></i> Áp dụng
                </button>
              </div>
              <div id="VoucherMessage" class="mt-2" style="display: none;"></div>
            </div>

            <div class="card-header bg-light">
              <h4 class="mb-0">Tổng đơn hàng</h4>
            </div>
            <div class="card-body">
              <div class="d-flex justify-content-between mb-3">
                <span>Tạm tính (@Model.CartItems.Count sản phẩm)</span>
                <span class="fw-bold total-cart">@total.ToString("N0")đ</span>
              </div>
              <div class="d-flex justify-content-between mb-3">
                <span>Phí vận chuyển</span>
                <span class="text-success">Miễn phí</span>
              </div>
              <div class="d-flex justify-content-between mb-3">
                <span>Giảm giá</span>
                <span class="text-success discount-amount">- 0đ</span>
              </div>
              <hr>
              <div class="d-flex justify-content-between mb-4">
                <span class="fw-bold">Tổng cộng</span>
                <span class="fw-bold text-primary fs-5 final-amount">@total.ToString("N0")đ</span>
              </div>
              
              <!-- Hidden input to store total amount for VNPay -->
              <input type="hidden" id="totalAmountValue" value="@total" />

              @* Phương thức thanh toán *@
              <div class="mb-4">
                <h6 class="mb-3"><i class="fas fa-wallet me-2"></i>Phương thức thanh toán</h6>
                
                <div class="payment-methods">
                  <!-- COD Payment -->
                  <div class="form-check payment-option mb-3 p-3 border rounded">
                    <input class="form-check-input" type="radio" name="PaymentMethod" id="paymentCOD" value="0" checked>
                    <label class="form-check-label w-100" for="paymentCOD">
                      <div class="d-flex align-items-center">
                        <i class="fas fa-money-bill-wave text-success me-3 fs-4"></i>
                        <div>
                          <strong>Thanh toán khi nhận hàng (COD)</strong>
                          <p class="text-muted mb-0 small">Thanh toán bằng tiền mặt khi nhận hàng</p>
                        </div>
                      </div>
                    </label>
                  </div>

                  <!-- Bank Transfer -->
                  @* <div class="form-check payment-option mb-3 p-3 border rounded">
                    <input class="form-check-input" type="radio" name="PaymentMethod" id="paymentBank" value="1">
                    <label class="form-check-label w-100" for="paymentBank">
                      <div class="d-flex align-items-center">
                        <i class="fas fa-university text-primary me-3 fs-4"></i>
                        <div>
                          <strong>Chuyển khoản ngân hàng</strong>
                          <p class="text-muted mb-0 small">Chuyển khoản qua ngân hàng</p>
                        </div>
                      </div>
                    </label>
                  </div> *@

                  <!-- VNPay Payment -->
                  <div class="form-check payment-option mb-3 p-3 border rounded">
                    <input class="form-check-input" type="radio" name="PaymentMethod" id="paymentVNPay" value="2">
                    <label class="form-check-label w-100" for="paymentVNPay">
                      <div class="d-flex align-items-center">
                        <img src="https://vnpay.vn/s1/statics.vnpay.vn/2023/9/06ncktiwd6dc1694418196384.png" 
                             alt="VNPay" class="me-3" style="width: 50px; height: auto;">
                        <div>
                          <strong>Thanh toán qua VNPay</strong>
                          <p class="text-muted mb-0 small">Thanh toán an toàn qua cổng VNPay</p>
                        </div>
                      </div>
                    </label>
                  </div>
                </div>
              </div>

              @* Nút đặt hàng *@
              <button id="SubmitOrderButton" class="btn btn-primary btn-lg w-100 py-3 fw-bold">
                <i class="fa fa-credit-card me-2"></i>Đặt hàng
              </button>
            </div>
          </div>
        </div>
      </div>
    }
  </div>
</div>

<style>
  .payment-option {
    cursor: pointer;
    transition: all 0.3s ease;
  }

  .payment-option:hover {
    background-color: #f8f9fa;
    border-color: #007bff !important;
  }

  .payment-option input[type="radio"]:checked + label {
    background-color: #e7f3ff;
  }

  .payment-option input[type="radio"]:checked ~ label .form-check-label {
    font-weight: 600;
  }
  
  /* Payment error alert animation */
  .alert {
    animation: slideDown 0.5s ease-out;
  }
  
  @@keyframes slideDown {
    from {
      opacity: 0;
      transform: translateY(-20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .payment-option{
    display: flex;
    align-items: center;
  }
</style>