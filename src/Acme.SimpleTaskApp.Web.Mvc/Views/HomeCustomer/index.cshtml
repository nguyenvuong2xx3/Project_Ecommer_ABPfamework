@using Acme.SimpleTaskApp.Products;
@using Acme.SimpleTaskApp.Web.Models.HomeCustomers
@using Acme.SimpleTaskApp.Web.Models.Products;
@model HomeCustomerViewModel
@{
  ViewData["Title"] = "Index";
  Layout = "~/Views/Shared/Layout/Customer/_LayoutCustomer.cshtml";
}

@section scripts
{
  <environment names="Development">
    <script src="~/view-resources/Views/HomeCustomer/MainCustomer.js" asp-append-version="true"></script>
  </environment>
}
@await Component.InvokeAsync("Banners", new { viewName = "BannerHomeTop" })


<!-- Main Container -->
<div class="main-container mt-3">
  <div class="products-header">
    <h3>Tất cả sản phẩm</h3>
  </div>
  <div class="products-grid">
    @foreach (var product in Model.ProductsInfo)
    {
      var item = product.ProductVariants.FirstOrDefault();
      if (item != null)
      {
        <div class="product-item">
          <div class="product-card productvariant-click-detail cursor" data-id="@item.Id">
            <!-- Discount Badge -->
            @if (item.HasActiveDiscount && item.DiscountPercentage > 0)
            {
              <div class="discount-badge">
                <i class="fas fa-bolt"></i> -@item.DiscountPercentage.ToString("0.#")%
              </div>
            }

            <div class="image-container">
              @if (item.ImageUrl != null)
              {
                <img src="@item.ImageUrl" class="product-image" alt="@product.Name">
              }
              else
              {
                <img src="~/img/products/default.png" class="product-image" alt="@product.Name">
              }
            </div>

            <div class="product-info">
              <div class="product-name">
                @product.Name
              </div>

              

              <div class="product-tags">
                @if (!string.IsNullOrEmpty(item.Ram))
                {
                  <span class="product-tag">@item.Ram</span>
                }
                @if (!string.IsNullOrEmpty(item.Storage))
                {
                  <span class="product-tag">@item.Storage</span>
                }
                @if (!string.IsNullOrEmpty(item.Color))
                {
                  <span class="product-tag">@item.Color</span>
                }
              </div>

              <div class="product-price">
                @if (item.HasActiveDiscount && item.DiscountPercentage > 0)
                {
                  <!-- Giá gốc gạch ngang -->
                  <div class="original-price">@item.Price.ToString("#,##0")₫</div>
                  <!-- Giá sau giảm -->
                  <div class="current-price">@item.DiscountedPrice.ToString("#,##0")₫</div>
                  <!-- Tên chương trình sale -->
                  @* @if (!string.IsNullOrEmpty(item.SaleName))
                  {
                    <span class="discount-text">
                      <i class="fas fa-gift"></i> @item.SaleName
                    </span>
                  }
                  else
                  {
                    <span class="discount-text">
                      <i class="fas fa-fire"></i> Đang giảm giá
                    </span>
                  } *@
                }
                else
                {
                  <!-- Giá bình thường -->
                  <div class="current-price">@item.Price.ToString("#,##0")₫</div>
                }
              </div>
              <!-- đánh giá sao -->
              @if (item.TotalRatings > 0)
              {
                <div class="product-rating mb-2">
                  <div class="rating-stars">
                    @for (int i = 1; i <= 5; i++)
                    {
                      if (i <= Math.Floor(item.AverageRating))
                      {
                        <i class="fas fa-star text-warning"></i>
                      }
                      else if (i <= Math.Ceiling(item.AverageRating))
                      {
                        <i class="fas fa-star-half-alt text-warning"></i>
                      }
                      else
                      {
                        <i class="far fa-star text-warning"></i>
                      }
                    }
                  </div>
                  <span class="rating-text">@item.AverageRating.ToString("0.0") (@item.TotalRatings)</span>
                </div>
              }
              @* đã bán *@
              @if (item.SoldQuantity > 0)
              {
                <div class="sold-info" style="margin: 0px;">
                  <i class="fas fa-shopping-cart"></i>
                  <span class="sold-text">Đã bán: <strong>@item.SoldQuantity</strong></span>
                </div>
              }
              <!-- Stock Quantity -->
              <div class="stock-status">
                @if (item.StockQuantity == 0)
                {
                  <div class="sold-out-overlay">
                    <i class="fas fa-ban"></i>
                    Hết hàng
                  </div>
                }
              </div>
            </div>
            <div class="sold-info" style="margin: 0px;">
              <i class="fas fa-shopping-bag"></i>
              <span class="sold-text">Đã bán <strong>@item.SoldQuantity</strong></span>
            </div>
            @* <button class="detail-btn productvariant-click-detail" data-id="@item.Id">
              Xem chi tiết
            </button> *@
          </div>
        </div>
      }
    }
  </div>
</div>

@await Component.InvokeAsync("ProductList", new { viewName = "FilterCreatetion" })
@await Component.InvokeAsync("ProductList", new { viewName = "FilterPrice" }) 



<style>
  .product-rating.mb-2 .rating-stars {
    display: inline-block;
    font-size: 1em;
  }

  .sold-info {
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 8px 15px;
    font-size: 12px;
    color: #666;
    border-bottom: 1px solid #f0f0f0;
    margin: 8px 0;
    background-color: #fafafa;
  }

    .sold-info i {
      color: #288ad6;
      font-size: 11px;
    }

  .sold-text {
    font-weight: 400;
  }

    .sold-text strong {
      color: #d0021b;
      font-weight: 600;
    }

  .product-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 5px;
    margin-bottom: 10px;
  }

  .product-tag {
    background-color: #e4e1e1;
    color: #555;
    padding: 3px 8px;
    border-radius: 12px;
    font-size: 11px;
    font-weight: 500;
    white-space: nowrap;
  }

  .product-name {
    font-size: 14px;
    font-weight: 500;
    color: #444;
    height: 40px;
    overflow: hidden;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    line-height: 1.4;
    margin-bottom: 8px;
  }

  .sold-out-overlay {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 160px;
    background: rgba(173, 173, 173, 0.5);
    color: #000;
    font-size: 16px;
    font-weight: 700;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 6px;
    border-bottom: 1px solid #f3f3f3;
  }

    .sold-out-overlay i {
      font-size: 22px;
    }

  .main-container {
    width: 1200px;
    height: 980px;
    background-color: white;
    margin: 0 auto;
    padding: 20px;
    box-sizing: border-box;
    border-radius: 15px;
  }

  .products-header {
    padding-bottom: 25px;
    border-bottom: 1px solid #eee;
    margin-bottom: 20px;
  }

    .products-header h3 {
      font-size: 24px;
      font-weight: 700;
      color: #444;
      margin: 0;
      text-transform: uppercase;
    }

  .products-grid {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    height: calc(100% - 80px);
    overflow-y: auto;
  }

  .product-item {
    width: 185px;
    height: 409px;
    margin: 0;
  }

  .product-card {
    width: 100%;
    height: 100%;
    border: 1px solid #e1e1e1;
    border-radius: 8px;
    background-color: white;
    display: flex;
    flex-direction: column;
    overflow: hidden;
    transition: all 0.3s ease;
    box-sizing: border-box;
    position: relative;
  }

    .product-card:hover {
      box-shadow: 0 5px 15px rgba(0, 0, 0, 0.1);
      transform: translateY(-3px);
    }

  .discount-badge {
    position: absolute;
    top: 10px;
    right: 10px;
    background: linear-gradient(135deg, #ff6b6b 0%, #ee5a6f 100%);
    color: white;
    padding: 6px 10px;
    border-radius: 20px;
    font-size: 12px;
    font-weight: 700;
    z-index: 10;
    box-shadow: 0 2px 8px rgba(255, 107, 107, 0.4);
    display: flex;
    align-items: center;
    gap: 4px;
  }

    .discount-badge i {
      font-size: 10px;
      animation: pulse 1.5s infinite;
    }

  @@keyframes pulse {
    0%, 100%

  {
    transform: scale(1);
  }

  50% {
    transform: scale(1.2);
  }

  }

  .image-container {
    width: 100%;
    height: 160px;
    display: flex;
    justify-content: center;
    align-items: center;
    overflow: hidden;
    background-color: white;
    border-bottom: 1px solid #f3f3f3;
    padding: 15px;
    box-sizing: border-box;
  }

  .product-image {
    width: auto;
    height: auto;
    object-fit: cover;
  }

  .product-info {
    padding: 15px 15px 0 15px;
    flex-grow: 1;
    background-color: white;
    box-sizing: border-box;
  }

  .product-price {
    margin-bottom: 10px;
  }

  .original-price {
    font-size: 13px;
    font-weight: 400;
    color: #999;
    text-decoration: line-through;
    margin-bottom: 4px;
  }

  .current-price {
    font-size: 16px;
    font-weight: 700;
    color: #d0021b;
    margin-bottom: 5px;
  }

  .products-grid::-webkit-scrollbar {
    width: 6px;
  }

  .products-grid::-webkit-scrollbar-track {
    background: #f1f1f1;
    border-radius: 3px;
  }

  .products-grid::-webkit-scrollbar-thumb {
    background: #c1c1c1;
    border-radius: 3px;
  }

    .products-grid::-webkit-scrollbar-thumb:hover {
      background: #a8a8a8;
    }
</style>