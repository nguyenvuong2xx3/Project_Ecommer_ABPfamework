@using Acme.SimpleTaskApp.Web.Models.Sales
@using Acme.SimpleTaskApp.Web.Startup
@using Acme.SimpleTaskApp.Sales
@model SaleViewModel

@{
  ViewBag.Title = "Quản lý Sale/Voucher";
  ViewBag.CurrentPageName = PageNames.Sales;
}

@section scripts
{
  <environment names="Development">
    <script src="~/view-resources/Views/Sales/Index.js" asp-append-version="true"></script>
  </environment>
}

<section class="content-header pb-3">
  <div class="container-fluid">
    <div class="row">
      <div class="col-sm-6">
        <h1><i class="fas fa-percent"></i> Quản lý Sale/Voucher</h1>
      </div>
      <div class="col-sm-6">
        <button type="button" id="CreateNewSaleButton" class="btn bg-blue float-sm-right">
          <i class="fa fa-plus-square"></i>
          Tạo mới Sale/Voucher
        </button>
      </div>
    </div>
  </div>
</section>

<section class="content">
  <div class="container-fluid">
    <div class="row">
      <div class="col-12">
        <div class="card">
          <div class="card-header">
            <form id="SaleSearchForm" class="form-horizontal">
              <!-- Tìm kiếm cơ bản -->
              <div class="row mb-3">
                <div class="col-md-4">
                  <div class="input-group">
                    <input type="text" name="Filter" id="Filter" class="form-control txt-search" placeholder="Tìm theo tên hoặc mã voucher..." />
                    <div class="input-group-append">
                      <button type="button" class="btn btn-primary btn-search">
                        <i class="fa fa-search"></i>
                      </button>
                    </div>
                  </div>
                </div>

                <div class="col-md-3">
                  <select id="DiscountTypeFilter" name="DiscountType" class="form-select">
                    <option value="">-- Tất cả loại --</option>
                    <option value="0">Tự động</option>
                    <option value="1">Voucher</option>
                  </select>
                </div>

                <div class="col-md-3">
                  <select id="IsActiveFilter" name="IsActive" class="form-select">
                    <option value="">-- Tất cả trạng thái --</option>
                    <option value="true">Đang kích hoạt</option>
                    <option value="false">Đã tắt</option>
                  </select>
                </div>
              </div>

              <!-- Bộ lọc nâng cao -->
              <div id="AdvancedFiltersArea" style="display: none" class="row">
                <!-- Phạm vi áp dụng -->
                <div class="col-md-3">
                  <label for="ApplyToFilter" class="form-label">Phạm vi áp dụng</label>
                  <select id="ApplyToFilter" name="ApplyTo" class="form-select">
                    <option value="">Tất cả</option>
                    <option value="0">Toàn bộ đơn hàng</option>
                    <option value="1">Theo danh mục</option>
                    <option value="2">Theo sản phẩm</option>
                    <option value="3">Theo biến thể</option>
                  </select>
                </div>

                <!-- Phần trăm giảm giá -->
                <div class="col-md-3">
                  <label for="MinDiscountPercentage" class="form-label">Giảm giá từ (%)</label>
                  <input type="number" id="MinDiscountPercentage" name="MinDiscountPercentage" class="form-control" min="0" max="100" step="0.01" placeholder="0" />
                </div>

                <div class="col-md-3">
                  <label for="MaxDiscountPercentage" class="form-label">Giảm giá đến (%)</label>
                  <input type="number" id="MaxDiscountPercentage" name="MaxDiscountPercentage" class="form-control" min="0" max="100" step="0.01" placeholder="100" />
                </div>

                <!-- Lọc đã hết lượt -->
                <div class="col-md-3">
                  <label class="form-label d-block">Trạng thái lượt dùng</label>
                  <div class="custom-control custom-checkbox">
                    <input type="checkbox" class="custom-control-input" id="HasUsageLimitReached" name="HasUsageLimitReached" value="true">
                    <label class="custom-control-label" for="HasUsageLimitReached">
                      Đã hết lượt
                    </label>
                  </div>
                </div>

                <!-- Nút hành động -->
                <div class="col-md-12 mt-3">
                  <button type="button" class="btn btn-primary btn-search">
                    <i class="fa fa-search"></i> Tìm kiếm
                  </button>
                  <button type="button" class="btn btn-secondary" id="ResetFilters">
                    <i class="fa fa-refresh"></i> Đặt lại
                  </button>
                </div>
              </div>

              <!-- Hiển thị/Ẩn bộ lọc nâng cao -->
              <div class="row mt-2">
                <div class="col-12">
                  <span id="ShowAdvancedFiltersSpan" class="text-muted clickable-item">
                    <i class="fa fa-angle-down"></i> Hiển thị bộ lọc nâng cao
                  </span>
                  <span id="HideAdvancedFiltersSpan" class="text-muted clickable-item" style="display: none">
                    <i class="fa fa-angle-up"></i> Ẩn bộ lọc nâng cao
                  </span>
                </div>
              </div>
            </form>
          </div>

          <div class="card-body">
            <div class="table-responsive">
              <table id="SalesTable" class="table table-striped table-bordered" style="width:100%">
                <thead>
                  <tr>
                    <th style="width: 80px">STT</th>
                    <th>Tên chương trình</th>
                    <th>Loại</th>
                    <th>Mã Voucher</th>
                    <th>Giảm giá (%)</th>
                    <th>Phạm vi</th>
                    <th>Thời gian</th>
                    <th>Sử dụng</th>
                    <th>Trạng thái</th>
                    <th style="width: 200px">Thao tác</th>
                  </tr>
                </thead>
                <tbody></tbody>
              </table>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
