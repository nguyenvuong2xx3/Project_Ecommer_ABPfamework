@using Acme.SimpleTaskApp.Web.Models.Sales
@using Acme.SimpleTaskApp.Web.Models.Common.Modals
@using Acme.SimpleTaskApp.Sales
@model SaleViewModel

@await Html.PartialAsync("~/Views/Shared/Modals/_ModalHeader.cshtml", new ModalHeaderViewModel("Tạo chương trình giảm giá mới"))

@section Scripts
{
  <script abp-src="/view-resources/App/_Bundles/dropzone.js" asp-append-version="true"></script>
  <script abp-src="/view-resources/App/_Bundles/tagify.js" asp-append-version="true"></script>
}
@section Styles {
  <link rel="stylesheet" abp-href="/view-resources/App/_Bundles/tagify.css" asp-append-version="true">
}

<form name="SaleCreateForm" role="form" class="form-horizontal">
  <div class="modal-body">
    <div class="row">
      <!-- Tên chương trình -->
      <div class="col-md-12">
        <div class="form-group">
          <label for="Name" class="control-label">
            Tên chương trình <span class="text-danger">*</span>
          </label>
          <input type="text" class="form-control" id="Name" name="Name" placeholder="Ví dụ: Flash Sale Tết 2024, Giảm giá sinh nhật..." required />
          <small class="text-muted">Độ dài từ 3-200 ký tự</small>
        </div>
      </div>

      <!-- Mô tả -->
      <div class="col-md-12">
        <div class="form-group">
          <label for="Description" class="control-label">Mô tả</label>
          <textarea class="form-control" id="Description" name="Description" rows="3" placeholder="Mô tả chi tiết về chương trình..."></textarea>
        </div>
      </div>

      <!-- Loại giảm giá -->
      <div class="col-md-6">
        <div class="form-group">
          <label for="DiscountType" class="control-label">
            Loại giảm giá <span class="text-danger">*</span>
          </label>
          <select class="form-select" id="DiscountType" name="DiscountType" required>
            <option value="">-- Chọn loại --</option>
            <option value="0">Tự động (không cần mã)</option>
            <option value="1">Voucher (yêu cầu nhập mã)</option>
          </select>
        </div>
      </div>

      <!-- Mã Voucher -->
      <div class="col-md-6" id="VoucherCodeGroup" style="display: none;">
        <div class="form-group">
          <label for="VoucherCode" class="control-label">
            Mã Voucher <span class="text-danger">*</span>
          </label>
          <div class="input-group">
            <input type="text" class="form-control" id="VoucherCode" name="VoucherCode" placeholder="VD: SALE2024" style="text-transform: uppercase" />
            <div class="input-group-append">
              <button type="button" class="btn btn-secondary" id="GenerateVoucherBtn" title="Tạo mã ngẫu nhiên">
                <i class="fa fa-random"></i>
              </button>
            </div>
          </div>
          <small class="text-muted">Tối đa 50 ký tự, không dấu</small>
        </div>
      </div>

      <!-- Thời gian áp dụng -->
      <div class="col-md-12">
        <div class="form-group">
          <label for="DateRange" class="control-label">
            Thời gian áp dụng <span class="text-danger">*</span>
          </label>
          <input type="text" class="form-control" id="DateRange" name="DateRange" placeholder="Chọn thời gian bắt đầu và kết thúc..." required readonly />
          <input type="hidden" id="StartDate" name="StartDate" />
          <input type="hidden" id="EndDate" name="EndDate" />
        </div>
      </div>

      <!-- Phần trăm giảm giá -->
      <div class="col-md-4">
        <div class="form-group">
          <label for="DiscountPercentage" class="control-label">
            Giảm giá (%) <span class="text-danger">*</span>
          </label>
          <input type="text" class="form-control" id="DiscountPercentage" name="DiscountPercentage" placeholder="Nhập % giảm giá" required />
        </div>
      </div>

      <!-- Giảm tối đa -->
      <div class="col-md-4">
        <div class="form-group">
          <label for="MaximumDiscountAmount" class="control-label">Giảm tối đa (VNĐ)</label>
          <input type="text" class="form-control" id="MaximumDiscountAmount" name="MaximumDiscountAmount" placeholder="Không giới hạn" />
          <small class="text-muted">Để trống nếu không giới hạn</small>
        </div>
      </div>

      <!-- Giá trị đơn tối thiểu -->
      <div class="col-md-4">
        <div class="form-group">
          <label for="MinimumOrderValue" class="control-label">Đơn hàng tối thiểu (VNĐ)</label>
          <input type="text" class="form-control" id="MinimumOrderValue" name="MinimumOrderValue" placeholder="0" />
        </div>
      </div>

      <!-- Giới hạn lượt sử dụng -->
      <div class="col-md-6">
        <div class="form-group">
          <label for="UsageLimit" class="control-label">Giới hạn lượt sử dụng</label>
          <input type="text" class="form-control" id="UsageLimit" name="UsageLimit" placeholder="Không giới hạn" />
          <small class="text-muted">Để trống nếu không giới hạn</small>
        </div>
      </div>

      <!-- Trạng thái -->
      <div class="col-md-6">
        <div class="form-group">
          <label class="control-label d-block">Trạng thái</label>
          <div class="custom-control custom-checkbox mt-2">
            <input type="checkbox" class="custom-control-input" id="IsActive" name="IsActive" checked>
            <label class="custom-control-label" for="IsActive">
              Kích hoạt ngay
            </label>
          </div>
        </div>
      </div>

      <!-- Phạm vi áp dụng -->
      <div class="col-md-12">
        <div class="form-group">
          <label for="ApplyTo" class="control-label">
            Áp dụng cho <span class="text-danger">*</span>
          </label>
          <select class="form-select" id="ApplyTo" name="ApplyTo" required>
            <option value="">-- Chọn phạm vi --</option>
            <option value="0">Toàn bộ đơn hàng</option>
            <option value="1">Theo danh mục</option>
            <option value="2">Theo sản phẩm</option>
            <option value="3">Theo biến thể sản phẩm</option>
          </select>
        </div>
      </div>

      <!-- Category Tags (hidden initially) -->
      <div class="col-md-12" id="CategoryIdsGroup" style="display: none;">
        <div class="form-group">
          <label for="CategoryTags" class="control-label">
            Chọn danh mục <span class="text-danger">*</span>
          </label>
          <input type="text" class="form-control customtag" id="CategoryTags" name="CategoryTags" placeholder="Chọn danh mục..." />
          <small class="text-muted">Chọn một hoặc nhiều danh mục</small>
        </div>
      </div>

      <!-- Product Tags (hidden initially) -->
      <div class="col-md-12" id="ProductIdsGroup" style="display: none;">
        <div class="form-group">
          <label for="ProductTags" class="control-label">
            Chọn sản phẩm <span class="text-danger">*</span>
          </label>
          <input type="text" class="form-control customtag" id="ProductTags" name="ProductTags" placeholder="Chọn sản phẩm..." />
          <small class="text-muted">Chọn một hoặc nhiều sản phẩm</small>
        </div>
      </div>

      <!-- Product Variant Tags (hidden initially) -->
      <div class="col-md-12" id="ProductVariantIdsGroup" style="display: none;">
        <div class="form-group">
          <label for="ProductVariantTags" class="control-label">
            Chọn biến thể <span class="text-danger">*</span>
          </label>
          <div class="input-group">
            <input type="text" class="form-control customtag" id="ProductVariantTags" name="ProductVariantTags" placeholder="Chọn biến thể sản phẩm..." />
          </div>
          <small class="text-muted">Chọn một hoặc nhiều biến thể</small>
        </div>
      </div>

    </div>
  </div>
  @await Html.PartialAsync("~/Views/Shared/Modals/_ModalFooterWithSaveAndCancel.cshtml")
</form>
<style>
  tags.tagify.form-control.tagify--focus {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
  }

  .customtag {
    height: 85px;
  }

  .tagify__input{
    width: 143px;
  }
</style>
