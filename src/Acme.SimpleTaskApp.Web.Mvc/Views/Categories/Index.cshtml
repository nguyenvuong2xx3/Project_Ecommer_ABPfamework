@using Acme.SimpleTaskApp.Web.Startup
@using Abp.Localization
@using Acme.SimpleTaskApp.Web.Models.Categories
@using static Acme.SimpleTaskApp.Categories.Category
@model CategoryViewModel
@{
  ViewBag.Title = L("Categories");
  ViewBag.CurrentPageName = PageNames.Categories;
}

@section scripts
{
  <environment names="Development">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/jstree/3.3.12/themes/default/style.min.css" />
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jstree/3.3.12/jstree.min.js"></script>
    <script src="~/view-resources/Views/Categories/Index.js" asp-append-version="true"></script>
  </environment>

  <environment names="Staging,Production">
    <script src="~/view-resources/Views/Categories/Index.min.js" asp-append-version="true"></script>
  </environment>
}


<section class="content-header">
  <div class="container-fluid">
    <div class="row">
      <div class="col-sm-6">
        <h1>@L("Categories")</h1>
      </div>
      <div class="col-sm-6">
        <button type="button" id="CreateNewButton" class="btn bg-blue float-sm-right">
          <i class="fa fa-plus-square"></i>
          @L("Create")
        </button>
      </div>
    </div>
  </div>
</section>
<section class="content">
  <div class="container-fluid">
    <div class="row">
      <div class="col-md-4">
        <div class="card">
          <div class="card-header p-0">
            <h3 class="card-title">Cây danh mục</h3>
          </div>
          <div class="card-body" style="max-height:600px;overflow:auto;">
            <div id="categoryTree"></div>
          </div>
        </div>
      </div>
      <div class="col-md-8">
        <div class="card">
          <div class="card-header d-flex justify-content-between">
            <h3 class="card-title">@L("Details")</h3>
            <div>
              <button id="editSelected" class="btn btn-sm btn-primary" style="display:none;"><i class="fas fa-pencil-alt"></i> @L("Edit")</button>
              <button id="deleteSelected" class="btn btn-sm btn-danger" style="display:none;"><i class="fas fa-trash"></i> @L("Delete")</button>
            </div>
          </div>
          <div class="card-body" id="categoryDetails">
            <p class="text-muted">Chọn một danh mục trong cây danh mục</p>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<div class="modal fade" id="CategoryEditModal" tabindex="-1" role="dialog" aria-labelledby="CategoryEditModalLabel" data-backdrop="static">
  <div class="modal-dialog modal-lg" role="document">
    <div class="modal-content">
    </div>
  </div>
</div>







