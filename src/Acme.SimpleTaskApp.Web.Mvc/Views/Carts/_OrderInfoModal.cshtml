@using Acme.SimpleTaskApp.Web.Models.Common.Modals
@using Acme.SimpleTaskApp.Web.Models.UserProfiles
@model UserProfileViewModel
<!-- Modal Content -->
@await Html.PartialAsync("~/Views/Shared/Modals/_ModalHeader.cshtml", new ModalHeaderViewModel("Thông tin giao hàng"))
<div class="modal-content">
  <div class="modal-body">
    <!-- Thông báo -->
    <div class="alert alert-info d-flex align-items-center" role="alert">
      <i class="fas fa-info-circle me-2"></i>
      <div>Vui lòng nhập đầy đủ thông tin</div>
    </div>
    <div class="divider"></div>
    <form name="InfoOrder">
      <div class="mb-4">
        <h6 class="section-title">
          <i class="fas fa-user"></i>Thông tin người đặt
        </h6>

        <div class="mb-3">
          <div class="form-check form-check-inline">
            <input class="form-check-input" type="radio" name="GioiTinh" id="genderMale" value="1" @(Model.User.GioiTinh == 1 ? "checked" : "")>
            <label class="form-check-label" for="genderMale">Anh</label>
          </div>
          <div class="form-check form-check-inline">
            <input class="form-check-input" type="radio" name="GioiTinh" id="genderFemale" value="0" @(Model.User.GioiTinh == 0 ? "checked" : "")>
            <label class="form-check-label" for="genderFemale">Chị</label>
          </div>
          <div class="form-check form-check-inline">
            <input class="form-check-input" type="radio" name="GioiTinh" id="genderOther" value="2" @(Model.User.GioiTinh == 2 ? "checked" : "")>
            <label class="form-check-label" for="genderOther">Khác</label>
          </div>
        </div>

        <div class="mb-3">
          <label for="FullName" class="form-label">Họ & Tên:</label>
          <input type="text" class="form-control" id="fullName" name="FullName" value="@Model.User.FullName" placeholder="Nhập họ tên" required>
        </div>

        <div class="mb-3">
          <label for="PhoneNumber" class="form-label">Số điện thoại:</label>
          <input type="text" class="form-control" id="phoneNumber" name="PhoneNumber" placeholder="Nhập số điện thoại" value="@Model.User.PhoneNumber">
        </div>
      </div>

      <!-- Hình thức giao hàng -->
      <div class="mb-4">
        <h6 class="section-title">
          <i class="fas fa-truck"></i>Chọn hình thức giao hàng
        </h6>
        <div class="row">
          <div class="col-md-6 mb-3">
            <div class="delivery-option active" id="homeDelivery">
              <div class="d-flex align-items-center">
                <i class="fas fa-home"></i>
                <div>
                  <h6 class="mb-1">Giao tận nơi</h6>
                  <p class="mb-0 text-muted small">Nhận hàng tại địa chỉ của bạn</p>
                </div>
              </div>
            </div>
          </div>
          <div class="col-md-6 mb-3">
            <div class="delivery-option" id="storePickup">
              <div class="d-flex align-items-center">
                <i class="fas fa-store"></i>
                <div>
                  <h6 class="mb-1">Nhận tại siêu thị</h6>
                  <p class="mb-0 text-muted small">Đến siêu thị gần nhất để nhận hàng</p>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
      <!-- Địa chỉ giao hàng -->
      <div class="mb-4">
        <h6 class="section-title">
          <i class="fas fa-map-marker-alt"></i>Địa chỉ giao hàng
        </h6>

        <div class="mb-3">
          <label for="addressDetail" class="form-label">Nhập địa chỉ chi tiết</label>
          <input type="text" class="form-control" id="addressDetail" value="@Model.User.DiaChiChiTiet" placeholder="Tòa nhà, Số nhà, Tên đường,...">
        </div>

        <div class="row">
          <div class="col-md-6 mb-3">
            <label for="province" class="form-label">Tỉnh/Thành phố</label>
            <select class="form-select" id="tinhThanh" name="TinhThanh" data-current-value="@Model.User.TinhThanh">
              <option value="">Chọn Tỉnh/Thành phố</option>
              @if (!string.IsNullOrEmpty(Model.User.TinhThanh))
              {
                <option value="@Model.User.TinhThanh" selected>@Model.TenTinhThanh</option>
              }
            </select>
          </div>
          <div class="col-md-6 mb-3">
            <label for="ward" class="form-label">Phường/Xã</label>
            <select class="form-select" id="phuongXa" name="PhuongXa" data-current-value="@Model.User.PhuongXa">
              <option value="">Chọn Phường/Xã</option>
              @if (!string.IsNullOrEmpty(Model.User.PhuongXa))
              {
                <option value="@Model.User.PhuongXa" selected>@Model.TenPhuongXa</option>
              }
            </select>
          </div>
        </div>
        <div class="checkbox-label">
          <input type="checkbox" class="form-check-input" id="otherReceiver">
          <label for="otherReceiver" class="form-check-label">Người khác nhận hàng</label>
        </div>
      </div>
    </form>
    <div class="footer-buttons">
      <button type="button" class="btn btn-primary save-button">
        Xác nhận <i class="fas fa-arrow-right ms-1"></i>
      </button>
    </div>
  </div>
</div>
<style>
  .payment-methods .form-check-input:checked + .form-check-label[for="zalopay"] {
    border-color: #0095da; /* Màu xanh của ZaloPay */
    background-color: #f0f9ff;
  }

  .payment-methods .form-check-label[for="zalopay"] i {
    color: #0095da; /* Màu xanh của ZaloPay */
  }

  .modal-content {
    border-radius: 12px;
    border: none;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.15);
    overflow: hidden;
  }

  .modal-header {
    background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
    color: white;
    border-bottom: none;
    padding: 20px 25px;
  }

  .modal-title {
    font-weight: 700;
    font-size: 1.3rem;
    display: flex;
    align-items: center;
  }

  .modal-header .btn-close {
    filter: invert(1);
    opacity: 0.8;
  }

    .modal-header .btn-close:hover {
      opacity: 1;
    }

  .modal-body {
    padding: 25px;
    background-color: #f8f9fa;
  }

  .step-indicator {
    display: flex;
    align-items: center;
    margin-bottom: 25px;
    background: white;
    padding: 15px;
    border-radius: 10px;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.08);
  }

  .step {
    width: 35px;
    height: 35px;
    border-radius: 50%;
    background-color: #e9ecef;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #6c757d;
    font-weight: bold;
    font-size: 0.9rem;
    margin-right: 10px;
    transition: all 0.3s ease;
  }

    .step.active {
      background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
      color: white;
      box-shadow: 0 4px 10px rgba(102, 126, 234, 0.4);
    }

  .step-line {
    flex-grow: 1;
    height: 3px;
    background-color: #e9ecef;
    margin: 0 12px;
    border-radius: 2px;
  }

  .step-label {
    font-size: 0.85rem;
    color: #6c757d;
    font-weight: 500;
    transition: all 0.3s ease;
  }

    .step-label.active {
      color: #667eea;
      font-weight: 600;
    }

  .alert-info {
    background: linear-gradient(135deg, #e3f2fd 0%, #bbdefb 100%);
    border: none;
    border-radius: 10px;
    color: #1565c0;
    border-left: 4px solid #2196f3;
  }

  .divider {
    height: 1px;
    background: linear-gradient(to right, transparent, #dee2e6, transparent);
    margin: 25px 0;
  }

  .section-title {
    font-weight: 700;
    margin-bottom: 20px;
    color: #2c3e50;
    font-size: 1.1rem;
    display: flex;
    align-items: center;
    padding-bottom: 10px;
    border-bottom: 2px solid #e9ecef;
  }

    .section-title i {
      margin-right: 10px;
      color: #667eea;
      width: 20px;
      text-align: center;
    }

  .form-label {
    font-weight: 600;
    color: #2c3e50;
    margin-bottom: 8px;
  }

  .form-control, .form-select {
    border-radius: 8px;
    border: 1px solid #e0e0e0;
    padding: 10px 15px;
    transition: all 0.3s ease;
    font-size: 0.95rem;
  }

    .form-control:focus, .form-select:focus {
      border-color: #667eea;
      box-shadow: 0 0 0 0.25rem rgba(102, 126, 234, 0.25);
      transform: translateY(-2px);
    }

  .form-check-input:checked {
    background-color: #667eea;
    border-color: #667eea;
  }

  .form-check-input:focus {
    border-color: #667eea;
    box-shadow: 0 0 0 0.25rem rgba(102, 126, 234, 0.25);
  }

  .login-section {
    background: linear-gradient(135deg, #fff9c4 0%, #fff176 100%);
    border-radius: 10px;
    padding: 18px 20px;
    margin-bottom: 25px;
    text-align: center;
    border: 1px solid #ffeb3b;
    box-shadow: 0 4px 12px rgba(255, 193, 7, 0.15);
  }

    .login-section i {
      color: #ff9800;
      margin-right: 8px;
    }

  .btn-outline-primary {
    color: #667eea;
    border-color: #667eea;
    border-radius: 8px;
    padding: 8px 16px;
    font-weight: 500;
    transition: all 0.3s ease;
  }

    .btn-outline-primary:hover {
      background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
      border-color: #667eea;
      color: white;
      transform: translateY(-2px);
      box-shadow: 0 4px 12px rgba(102, 126, 234, 0.3);
    }

  .delivery-option {
    border: 2px solid #e9ecef;
    border-radius: 12px;
    padding: 20px;
    margin-bottom: 15px;
    cursor: pointer;
    transition: all 0.3s ease;
    background: white;
    height: 100%;
  }

    .delivery-option:hover {
      border-color: #667eea;
      background-color: rgba(102, 126, 234, 0.05);
      transform: translateY(-3px);
      box-shadow: 0 6px 15px rgba(0, 0, 0, 0.1);
    }

    .delivery-option.active {
      border-color: #667eea;
      background: linear-gradient(135deg, #f8f9ff 0%, #f0f2ff 100%);
      box-shadow: 0 6px 15px rgba(102, 126, 234, 0.2);
    }

    .delivery-option i {
      font-size: 1.5rem;
      margin-right: 15px;
      color: #667eea;
    }

  .address-selected {
    background: linear-gradient(135deg, #e8f5e9 0%, #c8e6c9 100%);
    border-radius: 10px;
    padding: 15px 20px;
    margin-bottom: 20px;
    font-weight: 600;
    color: #2e7d32;
    border-left: 4px solid #4caf50;
  }

  .checkbox-label {
    display: flex;
    align-items: center;
    margin-bottom: 15px;
    padding: 10px 15px;
    background: white;
    border-radius: 8px;
    border: 1px solid #e9ecef;
    transition: all 0.3s ease;
  }

    .checkbox-label:hover {
      border-color: #667eea;
      background-color: rgba(102, 126, 234, 0.05);
    }

    .checkbox-label input {
      margin-right: 12px;
      transform: scale(1.2);
    }

  .footer-buttons {
    display: flex;
    justify-content: space-between;
    margin-top: 25px;
    padding-top: 20px;
    border-top: 1px solid #e9ecef;
  }

  .btn-primary {
    background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
    border: none;
    border-radius: 8px;
    padding: 10px 25px;
    font-weight: 600;
    transition: all 0.3s ease;
  }

    .btn-primary:hover {
      transform: translateY(-2px);
      box-shadow: 0 6px 15px rgba(102, 126, 234, 0.4);
    }

  .btn-outline-secondary {
    border-radius: 8px;
    padding: 10px 25px;
    font-weight: 500;
    transition: all 0.3s ease;
  }

    .btn-outline-secondary:hover {
      transform: translateY(-2px);
      box-shadow: 0 4px 10px rgba(108, 117, 125, 0.2);
    }

  /* Animation for form elements */
  .form-group {
    transition: all 0.3s ease;
  }

  /* Responsive adjustments */

  .step-line {
    display: none;
  }

  .step, .step-label {
    margin-bottom: 5px;
  }

  .footer-buttons {
    flex-direction: column;
    gap: 10px;
  }

    .footer-buttons button {
      width: 100%;
    }

  }
</style>
