@using Acme.SimpleTaskApp.Web.Startup
@model Acme.SimpleTaskApp.Web.Models.Orders.OrderViewModel

@{
	ViewBag.Title = L("Orders");
	ViewBag.CurrentPageName = PageNames.Orders;
}

@section scripts
{
	<environment names="Development">
		<script src="~/view-resources/Views/Orders/Index.js" asp-append-version="true"></script>
	</environment>

}


<section class="content-header pb-3">
	<div class="container-fluid">
		<div class="row">
			<div class="col-sm-6">
				<h1>@L("Orders")</h1>
			</div>
		</div>
	</div>
</section>
<section class="content">
	<div class="container-fluid">
		<div class="row">
			<div class="col-12">
				@await Html.PartialAsync("~/Views/Orders/Index.AdvancedSearch.cshtml")
				<div class="card">
					<div class="card-header">
						<div class="row">
							<div class="col-md-6">
							</div>
						</div>
					</div>
					<div class="card-body">
						<div class="table-responsive">
							<table id="OrdersTable" class="table table-striped table-bordered">
								<thead>
									<tr>
										<th>@L("FullName")</th>
										<th>@L("TotalAmount")</th>
										<th>@L("PaymentMethod")</th>
										<th>@L("CreationTime")</th>
										<th>@L("Status")</th>
										<th>@L("Actions")</th>
									</tr>
								</thead>
								<tbody>
								</tbody>
							</table>
						</div>
					</div>
				</div>
			</div>
		</div>
	</div>
</section>

<div class="modal fade" id="OrderEditModal" tabindex="-1" role="dialog" aria-labelledby="OrderEditModalLabel" data-backdrop="static">
	<div class="modal-dialog modal-lg" role="document">
		<div class="modal-content">
		</div>
	</div>
</div>


<div class="modal fade" id="OrderDetailModal" tabindex="-1" role="dialog" aria-labelledby="OrderDetailModalLabel" data-backdrop="static">
	<div class="modal-dialog modal-lg" role="document">
		<div class="modal-content"></div>
	</div>
</div>





