@using Acme.SimpleTaskApp.Web.Models.Common.Modals
@using Acme.SimpleTaskApp.Web.Models.Roles
@model RoleEditTreeViewModel
@{
  Layout = null;
}

@await Html.PartialAsync("~/Views/Shared/Modals/_ModalHeader.cshtml", new ModalHeaderViewModel(L("EditRole")))

<form name="roleEditForm" role="form" class="form-horizontal">
  <input type="hidden" name="Id" value="@Model.Role.Id" />
  <input type="hidden" name="IsStatic" value="@(Model.Role.IsStatic.ToString())" />
  <div class="modal-body">
    <!-- Tabs -->
    <ul class="nav nav-tabs" id="roleEditTabs" role="tablist">
      <li class="nav-item">
        <a class="nav-link active" id="edit-info-tab" data-toggle="tab" href="#tab-edit-info" role="tab">@L("RoleInfo")</a>
      </li>
      <li class="nav-item">
        <a class="nav-link" id="edit-permissions-tab" data-toggle="tab" href="#tab-edit-permissions" role="tab">@L("Permissions")</a>
      </li>
    </ul>

    <div class="tab-content p-3 border border-top-0">
      <!-- Thông tin vai trò -->
      <div class="tab-pane fade show active" id="tab-edit-info" role="tabpanel">
        <div class="row mb-3">
          <label class="col-md-3 col-form-label fw-bold">@L("RoleName") <span class="text-danger">*</span></label>
          <div class="col-md-9">
            <input id="rolename" class="form-control" type="text" name="Name" value="@Model.Role.Name" @(Model.Role.IsStatic ? "disabled" : "") required maxlength="32" minlength="2">
          </div>
        </div>

        <div class="row mb-3">
          <label class="col-md-3 col-form-label fw-bold">@L("DisplayName") <span class="text-danger">*</span></label>
          <div class="col-md-9">
            <input id="displayname" class="form-control" type="text" name="DisplayName" value="@Model.Role.DisplayName" required maxlength="32" minlength="2">
          </div>
        </div>

        <div class="row mb-3">
          <label class="col-md-3 col-form-label fw-bold">@L("RoleDescription")</label>
          <div class="col-md-9">
            <textarea class="form-control" name="Description" value="@Model.Role.Description" rows="3" maxlength="500" placeholder="Mô tả chi tiết về vai trò và quyền hạn..."></textarea>
          </div>
        </div>
      </div>

      <!-- Chọn quyền -->
      <div class="tab-pane fade" id="tab-edit-permissions" role="tabpanel">
        <div class="row mb-3">
          <div class="col-12">
            <h6 class="fw-bold border-bottom pb-2">@L("SelectPermissions")</h6>

            <!-- Search permissions -->
            <div class="row mb-3">
              <div class="col-md-6">
                <div class="input-group">
                  <span class="input-group-text"><i class="fas fa-search"></i></span>
                  <input type="text" id="editPermissionSearch" class="form-control" placeholder="@L("SearchPermissions")..." />
                </div>
              </div>
              <div class="col-md-6 text-end">
                <button type="button" id="editSelectAllPermissions" class="btn btn-outline-primary btn-sm me-2">
                  <i class="fas fa-check-double"></i> @L("SelectAll")
                </button>
                <button type="button" id="editDeselectAllPermissions" class="btn btn-outline-secondary btn-sm">
                  <i class="fas fa-times"></i> @L("DeselectAll")
                </button>
              </div>
            </div>

            <!-- Permission tree container -->
            <div class="permission-tree-container border rounded p-3">
              <!-- Loading indicator -->
              <div class="permission-tree-loading text-center py-3">
                <i class="fas fa-spinner fa-spin fa-2x text-muted mb-2"></i>
                <p class="text-muted">@L("Loading")...</p>
              </div>

              <!-- Tree will be rendered here -->
              <div id="editPermissionTree" class="permission-tree" style="max-height: 400px; overflow-y: auto; display: none;"></div>
            </div>

            <!-- Selected permissions summary -->
            <div class="selected-permissions-summary mt-3">
              <div class="alert alert-info">
                <i class="fas fa-info-circle me-2"></i>
                <span id="editSelectedPermissionsCount">0</span> @L("PermissionsSelected")
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
  @await Html.PartialAsync("~/Views/Shared/Modals/_ModalFooterWithSaveAndCancel.cshtml")
</form>

<style>
  .permission-tree {
    font-family: inherit;
    font-size: 0.9rem;
  }

  /* Ẩn highlight khi click */
  .jstree-clicked {
    background: none !important;
    color: inherit !important;
    font-weight: normal !important;
  }

  /* Ẩn highlight khi hover */
  .jstree-anchor:hover {
    background: none !important;
    color: inherit !important;
  }

  /* Chỉ hiển thị dấu tick cho checkbox */
  .jstree-checked > .jstree-anchor {
    background: none !important;
    color: inherit !important;
    font-weight: normal !important;
  }

  /* Styling cho checkbox tick */
  .jstree-checkbox {
    margin-right: 8px;
  }

  /* Khi được chọn, chỉ thay đổi màu icon (tuỳ chọn) */
  .jstree-checked .jstree-leaf .jstree-icon:before {
    color: #28a745 !important; /* Green khi được chọn */
  }

  .jstree-anchor {
    padding: 4px 8px;
    border-radius: 4px;
    transition: none !important; /* Bỏ transition */
  }

  /* Search highlight vẫn giữ nguyên */
  .jstree-search {
    color: #d32f2f !important;
    font-weight: 600;
    background-color: #ffebee !important;
  }

  /* Đảm bảo text không bị thay đổi khi chọn */
  .jstree-checked > .jstree-anchor .jstree-anchor {
    color: inherit !important;
    background: none !important;
  }
</style>