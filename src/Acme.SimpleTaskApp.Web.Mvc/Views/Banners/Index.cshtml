@using Acme.SimpleTaskApp.Web.Models.Banners
@using Acme.SimpleTaskApp.Web.Startup
@using Acme.SimpleTaskApp.Banners
@using Acme.SimpleTaskApp.Authorization
@model BannerViewModel

@{
    ViewBag.Title = "Quản lý Banner";
    ViewBag.CurrentPageName = PageNames.Banners;
}

@section scripts
{
    <environment names="Development">
        <script src="~/view-resources/Views/Banners/Index.js" asp-append-version="true"></script>
    </environment>
}

<section class="content-header pb-3">
    <div class="container-fluid">
        <div class="row">
            <div class="col-sm-6">
                <h1><i class="fas fa-image"></i> Quản lý Banner</h1>
            </div>
            <div class="col-sm-6">
                @if (await PermissionChecker.IsGrantedAsync(PermissionNames.Pages_Banners_Create))
                {
                    <button type="button" id="CreateNewBannerButton" class="btn bg-blue float-sm-right">
                        <i class="fa fa-plus-square"></i>
                        Tạo mới Banner
                    </button>
                }
            </div>
        </div>
    </div>
</section>

<section class="content">
    <div class="container-fluid">
        <div class="row">
            <div class="col-12">
                <div class="card">
                    <div class="card-header">
                        <form id="BannerSearchForm" class="form-horizontal">
                            <!-- Tìm kiếm cơ bản -->
                            <div class="row mb-3">
                                <div class="col-md-4">
                                    <div class="input-group">
                                        <input type="text" name="Filter" id="Filter" class="form-control txt-search" placeholder="Tìm kiếm theo tiêu đề..." />
                                        <div class="input-group-append">
                                            <button type="button" class="btn btn-primary btn-search">
                                                <i class="fa fa-search"></i>
                                            </button>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!-- Bộ lọc nâng cao -->
                            <div id="AdvancedFiltersArea" style="display: none" class="row">
                                <!-- Vị trí -->
                                <div class="col-md-3">
                                    <label for="PositionFilter" class="form-label">Vị trí hiển thị</label>
                                    <select id="PositionFilter" name="Position" class="form-control">
                                        <option value="">Tất cả vị trí</option>
                                        <option value="0">Trên cùng trang chủ</option>
                                        <option value="1">Giữa trang chủ</option>
                                        <option value="2">Cuối trang chủ</option>
                                        <option value="3">Thanh bên</option>
                                        <option value="4">Phần đầu trang</option>
                                        <option value="5">Phần chân trang</option>
                                        <option value="6">Trang chi tiết sản phẩm</option>
                                        <option value="7">Trang danh mục</option>
                                    </select>
                                </div>

                                <!-- Trạng thái -->
                                <div class="col-md-3">
                                    <label for="IsActiveFilter" class="form-label">Trạng thái</label>
                                    <select id="IsActiveFilter" name="IsActive" class="form-control">
                                        <option value="">Tất cả</option>
                                        <option value="true">Đang hoạt động</option>
                                        <option value="false">Tạm dừng</option>
                                    </select>
                                </div>

                                <!-- Nút hành động -->
                                <div class="col-md-12 mt-3">
                                    <button type="button" class="btn btn-primary btn-search">
                                        <i class="fa fa-search"></i> Tìm kiếm
                                    </button>
                                    <button type="button" class="btn btn-secondary" id="ResetFilters">
                                        <i class="fa fa-refresh"></i> Đặt lại
                                    </button>
                                </div>
                            </div>

                            <!-- Hiển thị/Ẩn bộ lọc nâng cao -->
                            <div class="row mt-2">
                                <div class="col-12">
                                    <span id="ShowAdvancedFiltersSpan" class="text-muted clickable-item">
                                        <i class="fa fa-angle-down"></i> Hiển thị bộ lọc nâng cao
                                    </span>
                                    <span id="HideAdvancedFiltersSpan" class="text-muted clickable-item" style="display: none">
                                        <i class="fa fa-angle-up"></i> Ẩn bộ lọc nâng cao
                                    </span>
                                </div>
                            </div>
                        </form>
                    </div>

                    <div class="card-body">
                        <div class="table-responsive">
                            <table id="BannersTable" class="table table-striped table-bordered" style="width:100%">
                                <thead>
                                    <tr>
                                        <th style="width: 80px">STT</th>
                                        <th>Ảnh</th>
                                        <th>Tiêu đề</th>
                                        <th>Vị trí</th>
                                        <th>Thứ tự</th>
                                        <th>Trạng thái</th>
                                        <th>Ngày tạo</th>
                                        <th style="width: 200px">Thao tác</th>
                                    </tr>
                                </thead>
                                <tbody></tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
