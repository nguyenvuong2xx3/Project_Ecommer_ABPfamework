@using Acme.SimpleTaskApp.Banners
@using Acme.SimpleTaskApp.Web.Models.Banners
@model BannerViewModel

<div class="modal-header">
  <h5 class="modal-title">
    <i class="fas fa-edit"></i> Chỉnh sửa Banner
  </h5>
  <button type="button" class="close" data-dismiss="modal" aria-label="Close">
    <span aria-hidden="true">&times;</span>
  </button>
</div>

<form name="BannerEditForm" role="form" novalidate class="form-validation">
  <input type="hidden" name="Id" value="@Model.Banner.Id" />
  <input type="hidden" name="CurrentImageUrl" id="CurrentImageUrl" value="@Model.Banner.ImageUrl" />

  <div class="modal-body">
    <div id="error-message" class="alert alert-danger" style="display: none;"></div>

    <div class="row">
      <!-- Tiêu đề -->
      <div class="col-md-12">
        <div class="form-group">
          <label for="Title" class="control-label">
            Tiêu đề <span class="text-danger">*</span>
          </label>
          <input type="text" class="form-control" id="Title" name="Title" value="@Model.Banner.Title" placeholder="Nhập tiêu đề banner..." required />
        </div>
      </div>

      <!-- Vị trí hiển thị -->
      <div class="col-md-6">
        <div class="form-group">
          <label for="Position" class="control-label">
            Vị trí hiển thị <span class="text-danger">*</span>
          </label>
          <select class="form-control p-0 ps-2" id="Position" name="Position" required>
            <option value="">-- Chọn vị trí --</option>
            <option value="0" selected="@(Model.Banner.Position == BannerPosition.HomeTop ? "selected" : null)">Trên cùng trang chủ</option>
            <option value="1" selected="@(Model.Banner.Position == BannerPosition.HomeMiddle ? "selected" : null)">Giữa trang chủ</option>
            <option value="2" selected="@(Model.Banner.Position == BannerPosition.HomeBottom ? "selected" : null)">Cuối trang chủ</option>
            <option value="3" selected="@(Model.Banner.Position == BannerPosition.Sidebar ? "selected" : null)">Thanh bên</option>
            <option value="4" selected="@(Model.Banner.Position == BannerPosition.Header ? "selected" : null)">Phần đầu trang</option>
            <option value="5" selected="@(Model.Banner.Position == BannerPosition.Footer ? "selected" : null)">Phần chân trang</option>
            <option value="6" selected="@(Model.Banner.Position == BannerPosition.ProductPage ? "selected" : null)">Trang chi tiết sản phẩm</option>
            <option value="7" selected="@(Model.Banner.Position == BannerPosition.CategoryPage ? "selected" : null)">Trang danh mục</option>
          </select>
        </div>
      </div>

      <!-- Thứ tự hiển thị -->
      <div class="col-md-6">
        <div class="form-group">
          <label for="SortOrder" class="control-label">
            Thứ tự hiển thị <span class="text-danger">*</span>
          </label>
          <input type="text" class="form-control" id="SortOrder" name="SortOrder" value="@Model.Banner.SortOrder" min="0" required />
          <small class="form-text text-muted">Số thứ tự càng nhỏ càng hiển thị trước</small>
        </div>
      </div>

      <!-- Trạng thái -->
      <div class="col-md-12">
        <div class="form-group">
          <div class="custom-control custom-switch">
            <input type="checkbox" class="custom-control-input" id="IsActive" name="IsActive" @(Model.Banner.IsActive ? "checked" : "")>
            <label class="custom-control-label" for="IsActive">
              Kích hoạt hiển thị
            </label>
          </div>
        </div>
      </div>

      <!-- Ảnh hiện tại -->
      @if (!string.IsNullOrEmpty(Model.Banner.ImageUrl))
      {
        <div class="col-md-12">
          <div class="form-group">
            <label class="control-label">Ảnh hiện tại:</label>
            <div class="position-relative d-inline-block">
              <img id="currentBannerImage" src="@Model.Banner.ImageUrl" alt="Current Banner" class="img-thumbnail d-block" style="max-width: 100%; max-height: 300px;">
            </div>
          </div>
        </div>
      }

      <!-- Upload ảnh mới -->
      <div class="col-md-12">
        <div class="form-group">
          <label for="BannerImage" class="control-label">
            Thay đổi ảnh Banner (tùy chọn)
          </label>
          <div class="custom-file">
            <input type="file" class="custom-file-input" id="BannerImage" name="BannerImage" accept="image/*">
            <label class="custom-file-label" for="BannerImage">Chọn ảnh mới...</label>
          </div>
          <small class="form-text text-muted">
            Định dạng: JPG, PNG, GIF. Kích thước đề xuất: 1920x600px. Để trống nếu không muốn thay đổi.
          </small>
        </div>
      </div>

      <!-- Preview ảnh mới -->
      <div class="col-md-12">
        <div class="form-group">
          <div id="newBannerImagePreviewContainer" style="display: none;">
            <label class="control-label">Ảnh mới (xem trước):</label>
            <div class="position-relative d-inline-block">
              <img id="newBannerImagePreview" src="" alt="New Preview" class="img-thumbnail" style="max-width: 100%; max-height: 300px; display: block;">
              <button type="button" class="btn btn-danger btn-sm position-absolute" id="deleteNewBannerImageBtn" style="top: 5px; right: 5px;">
                <i class="fas fa-times"></i>
              </button>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <div class="modal-footer">
    <button type="button" class="btn btn-secondary" data-dismiss="modal">
      <i class="fas fa-times"></i> Hủy
    </button>
    <button type="submit" class="btn btn-primary save-button">
      <i class="fas fa-save"></i> Cập nhật
    </button>
  </div>
</form>
