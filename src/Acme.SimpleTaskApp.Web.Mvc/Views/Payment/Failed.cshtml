@{
    ViewBag.Title = "Thanh toán thất bại";
}

<section class="content-header">
    <div class="container-fluid">
        <div class="row mb-2">
            <div class="col-sm-12">
                <h1>Thanh toán thất bại</h1>
            </div>
        </div>
    </div>
</section>

<section class="content">
    <div class="container-fluid">
        <div class="row justify-content-center">
            <div class="col-md-6">
                <div class="card card-danger">
                    <div class="card-body text-center">
                        <i class="fas fa-times-circle text-danger" style="font-size: 72px; margin: 20px 0;"></i>
                        <h3 class="text-danger">Thanh toán thất bại</h3>
                        <p class="text-muted">@ViewBag.Message</p>
                        
                        @if (!string.IsNullOrEmpty(ViewBag.OrderId))
                        {
                            <div class="alert alert-warning mt-4">
                                <p><strong>Mã đơn hàng:</strong> @ViewBag.OrderId</p>
                            </div>
                        }

                        <div class="mt-4">
                            <a href="/Cart" class="btn btn-primary">
                                <i class="fas fa-redo"></i> Thử lại
                            </a>
                            <a href="/HomeCustomer" class="btn btn-secondary">
                                <i class="fas fa-home"></i> Về trang chủ
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<style>
    .card-danger {
        border-top: 3px solid #dc3545;
    }
</style>
