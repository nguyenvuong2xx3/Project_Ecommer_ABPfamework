@using Acme.SimpleTaskApp.Web.Startup
@{
  ViewBag.Title = L("HomePage");
  ViewBag.CurrentPageName = PageNames.Home;
}

@section styles
{
  <style>
    /* Modern Dashboard Styles - Compact Version */
    :root {
      --gradient-blue: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
      --gradient-green: linear-gradient(135deg, #f093fb 0%, #f5576c 100%);
      --gradient-orange: linear-gradient(135deg, #4facfe 0%, #00f2fe 100%);
      --gradient-purple: linear-gradient(135deg, #43e97b 0%, #38f9d7 100%);
      --shadow-sm: 0 2px 8px rgba(0, 0, 0, 0.08);
      --shadow-md: 0 4px 12px rgba(0, 0, 0, 0.1);
    }

    body {
      background: linear-gradient(135deg, #f5f7fa 0%, #c3cfe2 100%);
      min-height: 100vh;
    }

    .content {
      padding-top: 1rem;
    }

    /* Compact Header */
    .dashboard-header {
      background: white;
      padding: 1rem 1.5rem;
      border-radius: 16px;
      box-shadow: var(--shadow-sm);
      margin-bottom: 1.5rem;
    }

    .dashboard-title {
      font-size: 1.5rem;
      font-weight: 700;
      background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      margin: 0;
    }

    .dashboard-subtitle {
      color: #64748b;
      font-size: 0.85rem;
      margin-top: 0.2rem;
    }

    /* Compact Stats Cards */
    .modern-stats-card {
      background: white;
      border-radius: 16px;
      padding: 1.25rem;
      box-shadow: var(--shadow-sm);
      transition: all 0.3s ease;
      border: 1px solid rgba(255, 255, 255, 0.8);
      position: relative;
      overflow: hidden;
      margin-bottom: 1rem;
      cursor: pointer;
    }

      .modern-stats-card::before {
        content: '';
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        height: 3px;
        background: var(--gradient-blue);
      }

      .modern-stats-card:hover {
        transform: translateY(-4px);
        box-shadow: var(--shadow-md);
      }

      .modern-stats-card.card-purple::before {
        background: var(--gradient-blue);
      }

      .modern-stats-card.card-pink::before {
        background: var(--gradient-green);
      }

      .modern-stats-card.card-cyan::before {
        background: var(--gradient-orange);
      }

      .modern-stats-card.card-teal::before {
        background: var(--gradient-purple);
      }

    .stats-icon-wrapper {
      width: 48px;
      height: 48px;
      border-radius: 12px;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 1.4rem;
      margin-bottom: 0.75rem;
      background: var(--gradient-blue);
      color: white;
      box-shadow: 0 4px 12px rgba(102, 126, 234, 0.25);
    }

    .card-pink .stats-icon-wrapper {
      background: var(--gradient-green);
      box-shadow: 0 4px 12px rgba(240, 147, 251, 0.25);
    }

    .card-cyan .stats-icon-wrapper {
      background: var(--gradient-orange);
      box-shadow: 0 4px 12px rgba(79, 172, 254, 0.25);
    }

    .card-teal .stats-icon-wrapper {
      background: var(--gradient-purple);
      box-shadow: 0 4px 12px rgba(67, 233, 123, 0.25);
    }

    .stats-value {
      font-size: 1.6rem;
      font-weight: 700;
      color: #1e293b;
      margin: 0;
      line-height: 1.2;
    }

    .stats-label {
      color: #64748b;
      font-size: 0.8rem;
      font-weight: 500;
      margin-top: 0.2rem;
      text-transform: uppercase;
      letter-spacing: 0.5px;
    }

    .stats-footer {
      margin-top: 0.75rem;
      padding-top: 0.75rem;
      border-top: 1px solid #e2e8f0;
      display: flex;
      align-items: center;
      font-size: 0.75rem;
      color: #64748b;
    }

    .stats-growth {
      display: inline-flex;
      align-items: center;
      padding: 0.2rem 0.6rem;
      border-radius: 10px;
      font-weight: 600;
      font-size: 0.7rem;
    }

      .stats-growth.positive {
        background: #dcfce7;
        color: #16a34a;
      }

      .stats-growth.negative {
        background: #fee2e2;
        color: #dc2626;
      }

    /* Compact Mini Stats */
    .modern-mini-stat {
      background: white;
      border-radius: 12px;
      padding: 0.9rem;
      box-shadow: var(--shadow-sm);
      transition: all 0.3s ease;
      margin-bottom: 0.75rem;
      border-left: 3px solid;
    }

      .modern-mini-stat:hover {
        transform: translateX(3px);
        box-shadow: var(--shadow-md);
      }

      .modern-mini-stat.stat-primary {
        border-left-color: #6366f1;
      }

      .modern-mini-stat.stat-success {
        border-left-color: #10b981;
      }

      .modern-mini-stat.stat-warning {
        border-left-color: #f59e0b;
      }

      .modern-mini-stat.stat-danger {
        border-left-color: #ef4444;
        cursor: pointer;
      }

        .modern-mini-stat.stat-danger:hover {
          background: #fef2f2;
        }

    .mini-stat-icon {
      width: 40px;
      height: 40px;
      border-radius: 10px;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 1.1rem;
      margin-right: 0.85rem;
    }

    .stat-primary .mini-stat-icon {
      background: #eef2ff;
      color: #6366f1;
    }

    .stat-success .mini-stat-icon {
      background: #d1fae5;
      color: #10b981;
    }

    .stat-warning .mini-stat-icon {
      background: #fef3c7;
      color: #f59e0b;
    }

    .stat-danger .mini-stat-icon {
      background: #fee2e2;
      color: #ef4444;
    }

    .mini-stat-label {
      font-size: 0.75rem;
      color: #64748b;
      font-weight: 500;
      margin-bottom: 0.15rem;
    }

    .mini-stat-value {
      font-size: 1.3rem;
      font-weight: 700;
      color: #1e293b;
    }

    /* Compact Charts */
    .modern-chart-card {
      background: white;
      border-radius: 16px;
      padding: 1.2rem;
      box-shadow: var(--shadow-sm);
      margin-bottom: 1rem;
    }

    .chart-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      margin-bottom: 1rem;
      padding-bottom: 0.85rem;
      border-bottom: 2px solid #f1f5f9;
    }

    .chart-title {
      font-size: 0.95rem;
      font-weight: 700;
      color: #1e293b;
      display: flex;
      align-items: center;
      gap: 0.4rem;
    }

      .chart-title i {
        width: 30px;
        height: 30px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 8px;
        background: linear-gradient(135deg, #667eea15, #764ba215);
        color: #667eea;
        font-size: 0.9rem;
      }

    .chart-container {
      min-height: 280px;
      position: relative;
    }

    /* Compact Tables */
    .modern-table-card {
      background: white;
      border-radius: 16px;
      padding: 0;
      box-shadow: var(--shadow-sm);
      overflow: hidden;
      margin-bottom: 1rem;
    }

    .table-card-header {
      padding: 1rem 1.2rem;
      background: linear-gradient(135deg, #f8fafc 0%, #f1f5f9 100%);
      border-bottom: 2px solid #e2e8f0;
    }

    .table-card-title {
      font-size: 0.95rem;
      font-weight: 700;
      color: #1e293b;
      margin: 0;
      display: flex;
      align-items: center;
      gap: 0.4rem;
    }

    .modern-table {
      margin: 0;
    }

      .modern-table thead th {
        background: #f8fafc;
        color: #475569;
        font-weight: 600;
        font-size: 0.75rem;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        padding: 0.85rem 1.2rem;
        border: none;
      }

      .modern-table tbody td {
        padding: 0.85rem 1.2rem;
        color: #334155;
        vertical-align: middle;
        border-bottom: 1px solid #f1f5f9;
        font-size: 0.85rem;
      }

      .modern-table tbody tr:hover {
        background: #f8fafc;
      }

    .modern-badge {
      padding: 0.3rem 0.75rem;
      border-radius: 10px;
      font-size: 0.7rem;
      font-weight: 600;
      display: inline-flex;
      align-items: center;
      gap: 0.3rem;
    }

      .modern-badge.badge-primary {
        background: #dbeafe;
        color: #1e40af;
      }

      .modern-badge.badge-success {
        background: #d1fae5;
        color: #065f46;
      }

      .modern-badge.badge-warning {
        background: #fef3c7;
        color: #92400e;
      }

      .modern-badge.badge-danger {
        background: #fee2e2;
        color: #991b1b;
      }

    .product-thumb {
      width: 40px;
      height: 40px;
      border-radius: 10px;
      object-fit: cover;
      box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
    }

    /* Low Stock Modal */
    .low-stock-modal .modal-content {
      border-radius: 20px;
      border: none;
    }

    .low-stock-modal .modal-header {
      background: linear-gradient(135deg, #fee2e2 0%, #fecaca 100%);
      border-radius: 20px 20px 0 0;
      border: none;
      padding: 1.5rem;
    }

    .low-stock-modal .modal-title {
      color: #991b1b;
      font-weight: 700;
    }

    .low-stock-item {
      padding: 1rem;
      border: 1px solid #f1f5f9;
      border-radius: 12px;
      margin-bottom: 0.75rem;
      transition: all 0.3s ease;
    }

      .low-stock-item:hover {
        background: #fef2f2;
        border-color: #fecaca;
      }

    /* Responsive */
    @@media (max-width: 768px) {
      .dashboard-header {
        padding: 0.85rem;
      }

      .dashboard-title {
        font-size: 1.25rem;
      }

      .modern-stats-card {
        padding: 1rem;
      }

      .stats-value {
        font-size: 1.3rem;
      }
    }
  </style>
}

@section scripts
{
  <environment names="Development">
    <script src="/themes/trezo/assets/js/apexcharts.min.js"></script>
    <script src="~/view-resources/Views/Home/Index.js" asp-append-version="true"></script>
  </environment>
}

<!-- Compact Dashboard Header -->
<div class="dashboard-header">
  <div class="d-flex justify-content-between align-items-center">
    <div>
      <h1 class="dashboard-title">
        <i class="fas fa-chart-line"></i> Dashboard
      </h1>
      <p class="dashboard-subtitle mb-0">Tổng quan hoạt động kinh doanh</p>
    </div>
    <div class="text-right">
      <span class="badge badge-light px-3 py-2" style="font-size: 0.8rem;">
        <i class="fas fa-calendar-alt mr-1"></i>
        <strong id="currentDate"></strong>
      </span>
    </div>
  </div>
</div>

<section class="content">
  <div class="container-fluid">

    <!-- Compact Main Stats Row -->
    <div class="row">
      <div class="col-xl-3 col-md-6">
        <div class="modern-stats-card card-purple">
          <div class="stats-icon-wrapper">
            <i class="fas fa-dollar-sign"></i>
          </div>
          <h3 class="stats-value" id="totalRevenue">
            <i class="fas fa-spinner fa-spin fa-sm"></i>
          </h3>
          <p class="stats-label">Doanh Thu</p>
          <div class="stats-footer">
            <span class="stats-growth positive" id="revenueGrowth">
              <i class="fas fa-spinner fa-spin fa-xs"></i>
            </span>
          </div>
        </div>
      </div>

      <div class="col-xl-3 col-md-6">
        <div class="modern-stats-card card-pink">
          <div class="stats-icon-wrapper">
            <i class="fas fa-shopping-cart"></i>
          </div>
          <h3 class="stats-value" id="totalOrders">
            <i class="fas fa-spinner fa-spin fa-sm"></i>
          </h3>
          <p class="stats-label">Đơn Hàng</p>
          <div class="stats-footer">
            <span class="stats-growth positive" id="ordersGrowth">
              <i class="fas fa-spinner fa-spin fa-xs"></i>
            </span>
          </div>
        </div>
      </div>

      <div class="col-xl-3 col-md-6">
        <div class="modern-stats-card card-cyan">
          <div class="stats-icon-wrapper">
            <i class="fas fa-box-open"></i>
          </div>
          <h3 class="stats-value" id="totalProducts">
            <i class="fas fa-spinner fa-spin fa-sm"></i>
          </h3>
          <p class="stats-label">Sản Phẩm</p>
          <div class="stats-footer">
            <span class="text-muted" id="lowStockInfo">
              <i class="fas fa-spinner fa-spin fa-xs"></i>
            </span>
          </div>
        </div>
      </div>

      <div class="col-xl-3 col-md-6">
        <div class="modern-stats-card card-teal">
          <div class="stats-icon-wrapper">
            <i class="fas fa-users"></i>
          </div>
          <h3 class="stats-value" id="totalCustomers">
            <i class="fas fa-spinner fa-spin fa-sm"></i>
          </h3>
          <p class="stats-label">Khách Hàng</p>
          <div class="stats-footer">
            <small class="text-muted" id="avgOrderValue">
              <i class="fas fa-spinner fa-spin fa-xs"></i>
            </small>
          </div>
        </div>
      </div>
    </div>

    <!-- Compact Secondary Stats -->
    <div class="row">
      <div class="col-lg-3 col-md-6">
        <div class="modern-mini-stat stat-primary d-flex align-items-center">
          <div class="mini-stat-icon">
            <i class="fas fa-clock"></i>
          </div>
          <div class="mini-stat-content">
            <div class="mini-stat-label">Chờ xử lý</div>
            <div class="mini-stat-value" id="pendingOrders">
              <i class="fas fa-spinner fa-spin fa-xs"></i>
            </div>
          </div>
        </div>
      </div>

      <div class="col-lg-3 col-md-6">
        <div class="modern-mini-stat stat-success d-flex align-items-center">
          <div class="mini-stat-icon">
            <i class="fas fa-check-circle"></i>
          </div>
          <div class="mini-stat-content">
            <div class="mini-stat-label">Hoàn thành</div>
            <div class="mini-stat-value" id="completedOrders">
              <i class="fas fa-spinner fa-spin fa-xs"></i>
            </div>
          </div>
        </div>
      </div>

      <div class="col-lg-3 col-md-6">
        <div class="modern-mini-stat stat-warning d-flex align-items-center">
          <div class="mini-stat-icon">
            <i class="fas fa-ticket-alt"></i>
          </div>
          <div class="mini-stat-content">
            <div class="mini-stat-label">Mã giảm giá</div>
            <div class="mini-stat-value" id="activeVouchers">
              <i class="fas fa-spinner fa-spin fa-xs"></i>
            </div>
          </div>
        </div>
      </div>

      <div class="col-lg-3 col-md-6">
        <div class="modern-mini-stat stat-danger d-flex align-items-center" id="lowStockCard" style="cursor: pointer; max-height: 80.04px" title="Click để xem chi tiết">
          <div class="mini-stat-icon">
            <i class="fas fa-exclamation-triangle"></i>
          </div>
          <div class="mini-stat-content">
            <div class="mini-stat-label">Sắp hết hàng (số lượng biến thể sản phẩm < 3)</div>
            <div class="mini-stat-value" id="lowStockProducts">
              <i class="fas fa-spinner fa-spin fa-xs"></i>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Compact Charts Row -->
    <div class="row">
      <div class="col-lg-8">
        <div class="modern-chart-card">
          <div class="chart-header">
            <h3 class="chart-title">
              <i class="fas fa-chart-area"></i>
              Doanh thu 30 ngày
            </h3>
            <span class="badge badge-light" style="font-size: 0.7rem;">30 ngày</span>
          </div>
          <div id="salesChart" class="chart-container"></div>
        </div>
      </div>

      <div class="col-lg-4">
        <div class="modern-chart-card">
          <div class="chart-header">
            <h3 class="chart-title">
              <i class="fas fa-chart-pie"></i>
              Theo danh mục
            </h3>
          </div>
          <div id="categoryChart" class="chart-container"></div>
        </div>
      </div>
    </div>

    <!-- Compact Tables Row -->
    <div class="row">
      <div class="col-lg-6">
        <div class="modern-table-card">
          <div class="table-card-header d-flex justify-content-between align-items-center">
            <h3 class="table-card-title">
              <i class="fas fa-fire text-danger"></i>
              Top Sản Phẩm
            </h3>
            <span class="modern-badge badge-primary">Top 5</span>
          </div>
          <div class="table-responsive">
            <table class="modern-table table table-hover mb-0">
              <thead>
                <tr>
                  <th>Sản phẩm</th>
                  <th class="text-center" style="width: 90px">Đã bán</th>
                  <th class="text-right" style="width: 120px">Doanh thu</th>
                </tr>
              </thead>
              <tbody id="topProductsTable">
                <tr>
                  <td colspan="3" class="text-center py-3">
                    <i class="fas fa-spinner fa-spin mr-2"></i> Đang tải...
                  </td>
                </tr>
              </tbody>
            </table>
          </div>
        </div>
      </div>

      <div class="col-lg-6">
        <div class="modern-table-card">
          <div class="table-card-header d-flex justify-content-between align-items-center">
            <h3 class="table-card-title">
              <i class="fas fa-receipt text-primary"></i>
              Đơn Hàng Gần Đây
            </h3>
            <a href="@Url.Action("Index", "Orders")" class="btn btn-sm btn-outline-primary" style="font-size: 0.75rem;">
              Xem tất cả <i class="fas fa-arrow-right ml-1"></i>
            </a>
          </div>
          <div class="table-responsive">
            <table class="modern-table table table-hover mb-0">
              <thead>
                <tr>
                  <th style="width: 90px">Mã đơn</th>
                  <th>Khách hàng</th>
                  <th class="text-right" style="width: 110px">Tổng tiền</th>
                  <th class="text-center" style="width: 100px">Trạng thái</th>
                </tr>
              </thead>
              <tbody id="recentOrdersTable">
                <tr>
                  <td colspan="4" class="text-center py-3">
                    <i class="fas fa-spinner fa-spin mr-2"></i> Đang tải...
                  </td>
                </tr>
              </tbody>
            </table>
          </div>
        </div>
      </div>
    </div>

  </div>
</section>

<script>
  // Set current date
  document.addEventListener('DOMContentLoaded', function() {
    const options = { day: 'numeric', month: 'numeric', year: 'numeric' };
    document.getElementById('currentDate').textContent = new Date().toLocaleDateString('vi-VN', options);
  });
</script>