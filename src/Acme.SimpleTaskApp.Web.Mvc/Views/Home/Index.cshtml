﻿@using Acme.SimpleTaskApp.Web.Startup
@{
  ViewBag.Title = L("HomePage");
  ViewBag.CurrentPageName = PageNames.Home;
}

@section styles
{
  <style>
    .stats-card {
      transition: all 0.3s ease;
      border-left: 3px solid;
      min-height: 100px;
      margin-bottom: 0.8rem;
    }

      .stats-card:hover {
        transform: translateY(-2px);
        box-shadow: 0 2px 8px rgba(0,0,0,0.1);
      }

      .stats-card .inner h3 {
        font-size: 1.4rem;
        margin-bottom: 3px;
        font-weight: 600;
      }

      .stats-card .inner p {
        font-weight: 500;
        margin-bottom: 3px;
        font-size: 0.85rem;
      }

      .stats-card .small-box-footer {
        font-size: 0.75rem;
        margin-top: 3px;
      }

      .stats-card .icon {
        font-size: 1.8rem;
        top: 15px;
      }

    .chart-container {
      position: relative;
      height: 250px;
    }

    .top-product-item {
      transition: all 0.2s ease;
      border-left: 2px solid transparent;
    }

      .top-product-item:hover {
        background-color: #f8f9fa;
        border-left-color: #007bff;
      }

    .status-badge {
      font-size: 0.7rem;
      padding: 0.2rem 0.5rem;
    }

    .product-image {
      width: 32px;
      height: 32px;
      object-fit: cover;
      border-radius: 3px;
    }

    .info-box {
      border-radius: 6px;
      overflow: hidden;
      margin-bottom: 0.8rem;
    }

    .info-box-icon {
      width: 50px;
      font-size: 1.2rem;
    }

    .info-box-content {
      padding: 0.4rem 0.6rem;
    }

    .info-box-text {
      font-size: 0.8rem;
    }

    .info-box-number {
      font-size: 1.1rem;
      font-weight: 600;
    }

    .table th {
      border-top: none;
      font-weight: 600;
      color: #495057;
      font-size: 0.8rem;
      padding: 0.5rem 0.4rem;
    }

    .table td {
      padding: 0.4rem;
      font-size: 0.8rem;
      vertical-align: middle;
    }

    .card {
      border-radius: 6px;
      box-shadow: 0 1px 5px rgba(0,0,0,0.06);
      margin-bottom: 1rem;
    }

    .card-header {
      background-color: #f8f9fa;
      border-bottom: 1px solid #dee2e6;
      padding: 0.6rem 0.8rem;
    }

    .card-title {
      font-weight: 600;
      color: #343a40;
      margin-bottom: 0;
      font-size: 0.9rem;
    }

    .card-body {
      padding: 0.8rem;
    }

    .content-header {
      padding: 0.8rem 0.5rem;
    }

      .content-header h1 {
        font-size: 1.3rem;
        margin: 0;
      }

    .breadcrumb {
      padding: 0.3rem 0.75rem;
      margin-bottom: 0;
      font-size: 0.8rem;
    }

    .container-fluid {
      padding: 0 0.8rem;
    }

    .btn-sm {
      padding: 0.2rem 0.5rem;
      font-size: 0.75rem;
    }

    .badge {
      font-size: 0.7rem;
      padding: 0.2rem 0.4rem;
    }
  </style>
}

@section scripts
{
  <environment names="Development">
    <script src="~/libs/chartjs/dist/Chart.js" asp-append-version="true"></script>
    <script src="~/view-resources/Views/Home/Index.js" asp-append-version="true"></script>
  </environment>
}

<div class="content-header">
  <div class="container-fluid">
    <div class="row align-items-center">
      <div class="col-sm-6">
        <h1 class="m-0 text-dark">
          <i class="fas fa-tachometer-alt mr-1"></i> Dashboard
        </h1>
      </div>
      <div class="col-sm-6">
        <ol class="breadcrumb float-sm-right">
          <li class="breadcrumb-item active">Dashboard</li>
        </ol>
      </div>
    </div>
  </div>
</div>

<section class="content">
  <div class="container-fluid">

    <!-- Compact Main Stats Row -->
    <div class="row">
      <div class="col-xl-3 col-md-6">
        <div class="small-box bg-info stats-card">
          <div class="inner">
            <h3 id="totalRevenue"><i class="fas fa-spinner fa-spin fa-sm"></i></h3>
            <p>Doanh thu</p>
            <div class="small-box-footer" id="revenueGrowth">
              <i class="fas fa-spinner fa-spin fa-xs"></i>
            </div>
          </div>
          <div class="icon"><i class="fas fa-dollar-sign"></i></div>
        </div>
      </div>

      <div class="col-xl-3 col-md-6">
        <div class="small-box bg-success stats-card">
          <div class="inner">
            <h3 id="totalOrders"><i class="fas fa-spinner fa-spin fa-sm"></i></h3>
            <p>Đơn hàng</p>
            <div class="small-box-footer" id="ordersGrowth">
              <i class="fas fa-spinner fa-spin fa-xs"></i>
            </div>
          </div>
          <div class="icon"><i class="fas fa-shopping-cart"></i></div>
        </div>
      </div>

      <div class="col-xl-3 col-md-6">
        <div class="small-box bg-warning stats-card">
          <div class="inner">
            <h3 id="totalProducts"><i class="fas fa-spinner fa-spin fa-sm"></i></h3>
            <p>Sản phẩm</p>
            <div class="small-box-footer" id="lowStockInfo">
              <i class="fas fa-spinner fa-spin fa-xs"></i>
            </div>
          </div>
          <div class="icon"><i class="fas fa-box"></i></div>
        </div>
      </div>

      <div class="col-xl-3 col-md-6">
        <div class="small-box bg-danger stats-card">
          <div class="inner">
            <h3 id="totalCustomers"><i class="fas fa-spinner fa-spin fa-sm"></i></h3>
            <p>Khách hàng</p>
            <div class="small-box-footer" id="avgOrderValue">
              <i class="fas fa-spinner fa-spin fa-xs"></i>
            </div>
          </div>
          <div class="icon"><i class="fas fa-users"></i></div>
        </div>
      </div>
    </div>

    <!-- Compact Secondary Stats -->
    <div class="row">
      <div class="col-lg-3 col-6">
        <div class="info-box">
          <span class="info-box-icon bg-primary"><i class="fas fa-clock"></i></span>
          <div class="info-box-content">
            <span class="info-box-text">Chờ xử lý</span>
            <span class="info-box-number" id="pendingOrders"><i class="fas fa-spinner fa-spin fa-xs"></i></span>
          </div>
        </div>
      </div>

      <div class="col-lg-3 col-6">
        <div class="info-box">
          <span class="info-box-icon bg-success"><i class="fas fa-check-circle"></i></span>
          <div class="info-box-content">
            <span class="info-box-text">Hoàn thành</span>
            <span class="info-box-number" id="completedOrders"><i class="fas fa-spinner fa-spin fa-xs"></i></span>
          </div>
        </div>
      </div>

      <div class="col-lg-3 col-6">
        <div class="info-box">
          <span class="info-box-icon bg-warning"><i class="fas fa-ticket-alt"></i></span>
          <div class="info-box-content">
            <span class="info-box-text">Mã giảm giá đang chạy</span>
            <span class="info-box-number" id="activeVouchers"><i class="fas fa-spinner fa-spin fa-xs"></i></span>
          </div>
        </div>
      </div>

      <div class="col-lg-3 col-6">
        <div class="info-box">
          <span class="info-box-icon bg-danger"><i class="fas fa-exclamation-triangle"></i></span>
          <div class="info-box-content">
            <span class="info-box-text">Sắp hết</span>
            <span class="info-box-number" id="lowStockProducts"><i class="fas fa-spinner fa-spin fa-xs"></i></span>
          </div>
        </div>
      </div>
    </div>

    <!-- Compact Charts Row -->
    <div class="row">
      <div class="col-lg-8">
        <div class="card">
          <div class="card-header py-1">
            <h3 class="card-title"><i class="fas fa-chart-line mr-1"></i>Doanh thu 30 ngày</h3>
            <div class="card-tools">
              <button type="button" class="btn btn-tool py-0" data-card-widget="collapse">
                <i class="fas fa-minus"></i>
              </button>
            </div>
          </div>
          <div class="card-body p-2">
            <div class="chart-container">
              <canvas id="salesChart"></canvas>
            </div>
          </div>
        </div>
      </div>

      <div class="col-lg-4">
        <div class="card">
          <div class="card-header py-1">
            <h3 class="card-title"><i class="fas fa-chart-pie mr-1"></i>Doanh thu danh mục</h3>
            <div class="card-tools">
              <button type="button" class="btn btn-tool py-0" data-card-widget="collapse">
                <i class="fas fa-minus"></i>
              </button>
            </div>
          </div>
          <div class="card-body p-2">
            <div class="chart-container">
              <canvas id="categoryChart"></canvas>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Compact Tables Row -->
    <div class="row">
      <div class="col-lg-6">
        <div class="card">
          <div class="card-header py-1 d-flex justify-content-between align-items-center">
            <h3 class="card-title"><i class="fas fa-fire mr-1"></i>Top sản phẩm</h3>
            <span class="badge badge-primary">Top 5</span>
          </div>
          <div class="card-body p-0">
            <div class="table-responsive">
              <table class="table table-sm table-hover mb-0">
                <thead class="thead-light">
                  <tr>
                    <th>Sản phẩm</th>
                    <th class="text-center" style="width: 70px">Đã bán</th>
                    <th class="text-right" style="width: 90px">Doanh thu</th>
                  </tr>
                </thead>
                <tbody id="topProductsTable">
                  <tr>
                    <td colspan="3" class="text-center py-2">
                      <i class="fas fa-spinner fa-spin fa-xs mr-1"></i> Đang tải...
                    </td>
                  </tr>
                </tbody>
              </table>
            </div>
          </div>
        </div>
      </div>

      <div class="col-lg-6">
        <div class="card">
          <div class="card-header py-1 d-flex justify-content-between align-items-center">
            <h3 class="card-title"><i class="fas fa-receipt mr-1"></i>Đơn hàng gần đây</h3>
            <a href="@Url.Action("Index", "Orders")" class="btn btn-xs btn-outline-primary py-0">
              Xem tất cả
            </a>
          </div>
          <div class="card-body p-0">
            <div class="table-responsive">
              <table class="table table-sm table-hover mb-0">
                <thead class="thead-light">
                  <tr>
                    <th style="width: 80px">Mã đơn</th>
                    <th>Khách hàng</th>
                    <th class="text-right" style="width: 90px">Tổng tiền</th>
                    <th class="text-center" style="width: 80px">Trạng thái</th>
                  </tr>
                </thead>
                <tbody id="recentOrdersTable">
                  <tr>
                    <td colspan="4" class="text-center py-2">
                      <i class="fas fa-spinner fa-spin fa-xs mr-1"></i> Đang tải...
                    </td>
                  </tr>
                </tbody>
              </table>
            </div>
          </div>
        </div>
      </div>
    </div>

  </div>
</section>