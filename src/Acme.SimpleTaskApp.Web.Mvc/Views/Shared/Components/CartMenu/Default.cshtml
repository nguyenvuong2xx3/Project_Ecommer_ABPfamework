@using Acme.SimpleTaskApp.Web.Views.Shared.Components.CartMenu
@model CartMenuViewModel

<a asp-controller="HomeCustomer" asp-action="Cart" class="btn-nav-action btn-cart">
  <div class="btn-icon-wrapper">
    <i class="fas fa-shopping-bag"></i>
    <span id="cart-count" class="cart-badge"
          style="display:@(Model.totalCartItems <= 0 ? "none" : "flex");">
      @Model.totalCartItems
    </span>
  </div>
</a>

<style>
  /* ========== CART BUTTON ========== */
  .btn-cart {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 8px 17px 8px 0px !important;
    text-decoration: none;
    transition: all 0.3s ease;
  }

  .btn-icon-wrapper {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }

  .btn-cart i {
    font-size: 24px;
    color: #333;
    transition: color 0.3s ease;
  }


  /* ========== CART BADGE ========== */
  .cart-badge {
    position: absolute;
    top: -8px;
    right: -10px;
    background: #dc3545;
    color: #fff;
    font-size: 11px;
    font-weight: 600;
    min-width: 18px;
    height: 18px;
    padding: 0 5px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    line-height: 1;
    border-radius: 7px;
  }

  /* Animation khi cập nhật số lượng */
  @@keyframes cartBounce {
    0%, 100%

  {
    transform: scale(1);
  }

  50% {
    transform: scale(1.2);
  }

  }

  .cart-badge. updated {
    animation: cartBounce 0.3s ease;
  }
</style>