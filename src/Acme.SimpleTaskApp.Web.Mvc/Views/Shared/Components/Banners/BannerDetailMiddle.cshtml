@using Acme.SimpleTaskApp.Web.Views.Shared.Components.Banners
@model BannersViewModel

<div class="container-fluid hero-header" style="background-color: #f8f9fa;">
  <div class="container d-flex justify-content-center align-items-center"
       min-height: 406px;">
    <div class="col-lg-10 pt-2">
      <div id="carouselId" class="carousel slide rounded overflow-hidden shadow" data-bs-ride="carousel">
        <div class="carousel-inner">
          @if (Model.Banners != null && Model.Banners.Any())
          {
            foreach (var banner in Model.Banners)
            {
              var isActive = banner == Model.Banners.First() ? "active" : "";
              <div class="carousel-item @isActive">
                <img src="@banner.ImageUrl" class="d-block w-100" style="height: auto; object-fit: cover;" alt="Banner slide">
              </div>
            }
          }
        </div>
      </div>
    </div>
  </div>
</div>