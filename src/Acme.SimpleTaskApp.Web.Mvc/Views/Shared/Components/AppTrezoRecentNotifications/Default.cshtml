@model Acme.SimpleTaskApp.Web.Views.Shared.Components.AppTrezoRecentNotifications.RecentNotificationsViewModel
@{
	//var theme = await GetTheme();
}

<li class="header-right-item">
	<div class="dropdown notifications noti" id="header_notification_bar">
	</div>

	<script id="headerNotificationBarTemplate" type="x-tmpl-mustache">

		{{#unreadCount}}
		<button class="btn btn-secondary border-0 p-0 position-relative" type="button" data-bs-toggle="dropdown" aria-expanded="false">
			<span class="material-symbols-outlined">notifications</span>
      <span class="position-absolute top-0 translate-middle badge rounded-pill bg-danger">
      {{unreadCount}}
    </span>
		</button>
		{{/unreadCount}}
		{{^unreadCount}}
		<button class="btn btn-secondary border-0 p-0 position-relative" type="button" data-bs-toggle="dropdown" id="notificationAlarmNew" aria-expanded="false">
			<span class="material-symbols-outlined">notifications</span>
		</button>
		{{/unreadCount}}

		<div class="dropdown-menu dropdown-lg p-0 border-0 p-0 dropdown-menu-end">

			<div class="d-flex justify-content-between align-items-center title">
				<span class="fw-semibold fs-15 text-secondary">Thông báo mới <span class="fw-normal text-body fs-14">({{unreadCount}})</span></span>
        <button class="p-0 m-0 bg-transparent border-0 fs-14 text-primary" id="btnSetAllNotificationsAsRead">Đọc hết</button>
			</div>

			<div class="max-h-217" id="NotificationList" data-simplebar>
				{{#notifications}}
				<div class="notification-menu unseen">
					<a href="#" class="dropdown-item">
						<div class="d-flex align-items-center">
							<div class="flex-shrink-0">
								<i class="material-symbols-outlined text-info">person</i>
							</div>
							<div class="flex-grow-1 ms-3">
								<p>{{text}}</p>
								<span class="fs-13">{{timeAgo}}</span>
							</div>
						</div>
					</a>

				</div><!-- notification-menu -->
				{{/notifications}}
			</div><!-- az-notification-list -->

			<a href="/App/Notifications" class="dropdown-item text-center text-primary d-block view-all fw-medium rounded-bottom-3">
				<span>Xem tất cả thông báo </span>
			</a>
		</div><!-- dropdown-menu -->



	</script>

</li>

