<div id="ratingFormContainer" class="rating-form-container" style="display: none;">
  <div class="rating-form-card">
    <div class="form-header">
      <h6><i class="fas fa-star"></i> Viết đánh giá</h6>
      <button type="button" class="btn-close-form" id="btnCancelRating">
        <i class="fas fa-times"></i>
      </button>
    </div>

    <form id="ratingForm">
      <input type="hidden" id="RatingId" name="Id" value="" />
      <input type="hidden" id="ProductIdInput" name="ProductId" value="" />

      <!-- Star Rating -->
      <div class="form-group">
        <label>Đánh giá của bạn <span class="required">*</span></label>
        <div class="star-selector" id="starRatingInput">
          @for (int i = 1; i <= 5; i++)
          {
            <i class="far fa-star" data-rating="@i"></i>
          }
        </div>
        <input type="hidden" id="RatingValue" name="Rating" value="0" required />
        <span class="rating-hint" id="ratingText">Chọn số sao</span>
      </div>

      <!-- Title -->
      <div class="form-group">
        <label>Tiêu đề <span class="optional">(tùy chọn)</span></label>
        <input type="text" class="form-input" id="RatingTitle" name="Title"
               maxlength="200" placeholder="VD: Sản phẩm tuyệt vời! ">
        <span class="char-count"><span id="titleCharCount">0</span>/200</span>
      </div>

      <!-- Review Text -->
      <div class="form-group">
        <label>Nội dung <span class="optional">(tùy chọn)</span></label>
        <textarea class="form-textarea" id="ReviewText" name="ReviewText"
                  rows="4" maxlength="2000"
                  placeholder="Chia sẻ trải nghiệm của bạn..."></textarea>
        <span class="char-count"><span id="reviewCharCount">0</span>/2000</span>
      </div>

      <!-- Image Upload -->
      <div class="form-group">
        <label>Hình ảnh <span class="optional">(tùy chọn)</span></label>
        <div class="upload-area" id="imageUploadArea">
          <i class="fas fa-camera"></i>
          <span>Thêm ảnh</span>
          <input type="file" id="RatingImages" name="Images" accept="image/*" multiple style="display: none;" />
        </div>
        <div id="imagePreviewContainer" class="image-previews"></div>
        <input type="hidden" id="ImageUrls" name="ImageUrls" value="" />
      </div>

      <!-- Actions -->
      <div class="form-actions">
        <button type="button" class="btn-submit-rating" id="btnSubmitRating">
          <i class="fas fa-paper-plane"></i> Gửi đánh giá
        </button>
      </div>
    </form>
  </div>
</div>

<style>
  . rating-form-container {
    margin-bottom: 16px;
  }

  .rating-form-card {
    background: #fffbeb;
    border: 1px solid #fde68a;
    border-radius: 12px;
    overflow: hidden;
  }

  .form-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 12px 16px;
    background: linear-gradient(135deg, #fbbf24, #f59e0b);
    color: #fff;
  }

    .form-header h6 {
      margin: 0;
      font-size: 14px;
      font-weight: 600;
    }

    .form-header i {
      margin-right: 6px;
    }

  .btn-close-form {
    background: rgba(255,255,255,0.2);
    border: none;
    color: #fff;
    width: 28px;
    height: 28px;
    border-radius: 50%;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
  }

    .btn-close-form:hover {
      background: rgba(255,255,255,0.3);
    }

  #ratingForm {
    padding: 16px;
  }

  .form-group {
    margin-bottom: 16px;
  }

    .form-group label {
      display: block;
      font-size: 13px;
      font-weight: 600;
      color: #78350f;
      margin-bottom: 6px;
    }

  .required {
    color: #dc2626;
  }

  .optional {
    font-weight: 400;
    color: #9ca3af;
    font-size: 11px;
  }

  /* Star Selector */
  . star-selector {
    display: flex;
    gap: 8px;
    margin-bottom: 4px;
  }

    .star-selector i {
      font-size: 28px;
      color: #d1d5db;
      cursor: pointer;
      transition: all 0.15s ease;
    }

      .star-selector i:hover,
      .star-selector i.active,
      .star-selector i.fas {
        color: #fbbf24;
        transform: scale(1.1);
      }

  . rating-hint {
    font-size: 11px;
    color: #92400e;
  }

  /* Inputs */
  .form-input,
  .form-textarea {
    width: 100%;
    padding: 10px 12px;
    border: 1px solid #fde68a;
    border-radius: 8px;
    font-size: 13px;
    background: #fff;
    transition: border-color 0. 2s, box-shadow 0.2s;
    outline: none;
  }

    .form-input:focus,
    .form-textarea:focus {
      border-color: #f59e0b;
      box-shadow: 0 0 0 3px rgba(251, 191, 36, 0.2);
    }

  .form-textarea {
    resize: none;
  }

  .char-count {
    display: block;
    text-align: right;
    font-size: 10px;
    color: #9ca3af;
    margin-top: 4px;
  }

  /* Upload Area */
  . upload-area {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    padding: 16px;
    background: #fff;
    border: 2px dashed #fde68a;
    border-radius: 8px;
    cursor: pointer;
    color: #92400e;
    font-size: 13px;
    transition: all 0. 2s;
  }

    .upload-area:hover {
      border-color: #f59e0b;
      background: #fef9c3;
    }

    .upload-area.dragover {
      border-color: #f59e0b;
      background: #fef9c3;
    }

  . image-previews {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
    margin-top: 8px;
  }

  .image-preview-item {
    position: relative;
    width: 64px;
    height: 64px;
    border-radius: 8px;
    overflow: hidden;
    border: 1px solid #e5e7eb;
  }

    .image-preview-item img {
      width: 100%;
      height: 100%;
      object-fit: cover;
    }

    .image-preview-item . remove-image {
      position: absolute;
      top: 2px;
      right: 2px;
      width: 18px;
      height: 18px;
      background: rgba(220, 38, 38, 0.9);
      border: none;
      border-radius: 50%;
      color: #fff;
      font-size: 10px;
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: center;
    }

  /* Submit Button */
  . form-actions {
    text-align: right;
  }

  .btn-submit-rating {
    background: linear-gradient(135deg, #f59e0b, #d97706);
    color: #fff;
    border: none;
    padding: 10px 20px;
    border-radius: 8px;
    font-size: 13px;
    font-weight: 600;
    cursor: pointer;
    transition: all 0. 2s;
  }

    .btn-submit-rating:hover {
      transform: translateY(-1px);
      box-shadow: 0 4px 12px rgba(245, 158, 11, 0.4);
    }

    .btn-submit-rating i {
      margin-right: 6px;
    }
</style>