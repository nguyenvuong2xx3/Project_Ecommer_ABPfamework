@using Acme.SimpleTaskApp.ProductRatings.Dtos
@model List<ProductRatingDto>

@{
  var productId = ViewBag.ProductId ?? 0;
  var statistics = ViewBag.RatingStatistics as ProductRatingStatisticsDto;
  var canRate = ViewBag.CanRate ?? false;
  var userRating = ViewBag.UserRating as ProductRatingDto;
}

<input type="hidden" id="ProductIdForRating" value="@productId" />

<!-- Product Rating Section -->
<div id="product-rating-section" class="bg-white p-4 rounded shadow-sm mt-3">

  <!-- Rating Summary -->
  <div class="row mb-4">
    <div class="col-md-4 text-center border-end">
      <h1 class="display-3 fw-bold text-warning mb-0">
        @(statistics?.AverageRating.ToString("0.0") ?? "0.0")
      </h1>
      <div class="rating-stars mb-2">
        @for (int i = 1; i <= 5; i++)
        {
          if (i <= Math.Floor(statistics?.AverageRating ?? 0))
          {
            <i class="fas fa-star text-warning fs-5"></i>
          }
          else if (i <= Math.Ceiling(statistics?.AverageRating ?? 0))
          {
            <i class="fas fa-star-half-alt text-warning fs-5"></i>
          }
          else
          {
            <i class="far fa-star text-warning fs-5"></i>
          }
        }
      </div>
      <p class="text-muted mb-0">
        @(statistics?.TotalRatings ?? 0) đánh giá
      </p>
      @if (statistics?.VerifiedPurchaseCount > 0)
      {
        <small class="text-success">
          <i class="fas fa-check-circle"></i> @statistics.VerifiedPurchaseCount đã mua hàng
        </small>
      }
    </div>

    <!-- Rating Distribution -->
    <div class="col-md-8">
      <h5 class="mb-3">Phân bố đánh giá</h5>
      @if (statistics != null && statistics.TotalRatings > 0)
      {
        @for (int star = 5; star >= 1; star--)
        {
          var count = star switch
          {
            5 => statistics.Distribution.FiveStars,
            4 => statistics.Distribution.FourStars,
            3 => statistics.Distribution.ThreeStars,
            2 => statistics.Distribution.TwoStars,
            1 => statistics.Distribution.OneStar,
            _ => 0
          };
          var percent = star switch
          {
            5 => statistics.Distribution.FiveStarsPercent,
            4 => statistics.Distribution.FourStarsPercent,
            3 => statistics.Distribution.ThreeStarsPercent,
            2 => statistics.Distribution.TwoStarsPercent,
            1 => statistics.Distribution.OneStarPercent,
            _ => 0
          };

          <div class="d-flex align-items-center mb-2">
            <span class="me-2" style="width: 60px;">@star <i class="fas fa-star text-warning small"></i></span>
            <div class="progress flex-grow-1 me-2" style="height: 10px;">
              <div class="progress-bar bg-warning" role="progressbar"
                   style="width: @percent%"
                   aria-valuenow="@percent" aria-valuemin="0" aria-valuemax="100">
              </div>
            </div>
            <span class="text-muted" style="width: 80px;">@count (@percent.ToString("0.0")%)</span>
          </div>
        }
      }
      else
      {
        <p class="text-muted">Chưa có đánh giá nào</p>
      }
    </div>
  </div>

  <!-- Filter Tabs -->
  <ul class="nav nav-tabs mb-3" id="ratingFilterTabs" role="tablist">
    <li class="nav-item" role="presentation">
      <button class="nav-link active" id="all-tab" data-bs-toggle="tab"
              data-bs-target="#all-ratings" type="button" role="tab"
              data-filter="all">
        Tất cả (@(statistics?.TotalRatings ?? 0))
      </button>
    </li>
    <li class="nav-item" role="presentation">
      <button class="nav-link" id="verified-tab" data-bs-toggle="tab"
              data-bs-target="#verified-ratings" type="button" role="tab"
              data-filter="verified">
        <i class="fas fa-check-circle text-success"></i> Đã mua hàng (@(statistics?.VerifiedPurchaseCount ?? 0))
      </button>
    </li>
    @for (int s = 5; s >= 1; s--)
    {
      var starCount = s switch
      {
        5 => statistics?.Distribution.FiveStars ?? 0,
        4 => statistics?.Distribution.FourStars ?? 0,
        3 => statistics?.Distribution.ThreeStars ?? 0,
        2 => statistics?.Distribution.TwoStars ?? 0,
        1 => statistics?.Distribution.OneStar ?? 0,
        _ => 0
      };

      <li class="nav-item" role="presentation">
        <button class="nav-link" id="@s-star-tab" data-bs-toggle="tab"
                data-bs-target="#@s-star-ratings" type="button" role="tab"
                data-filter="@s">
          @s <i class="fas fa-star text-warning small"></i> (@starCount)
        </button>
      </li>
    }
  </ul>

  <!-- Rating Form (if user can rate) -->
  @if (User.Identity.IsAuthenticated)
  {
    if (canRate && userRating == null)
    {
      <div class="alert alert-info">
        <i class="fas fa-star"></i> Bạn đã mua sản phẩm này. Hãy đánh giá để giúp người khác!
        <button class="btn btn-sm btn-primary float-end" id="btnShowRatingForm">
          <i class="fas fa-pen"></i> Viết đánh giá
        </button>
      </div>
    }
    else if (userRating != null)
    {
      <div class="alert alert-success">
        <i class="fas fa-check-circle"></i> Bạn đã đánh giá sản phẩm này (@userRating.Rating <i class="fas fa-star text-warning small"></i>)
        <button class="btn btn-sm btn-warning float-end" id="btnEditRating" data-rating-id="@userRating.Id">
          <i class="fas fa-edit"></i> Chỉnh sửa
        </button>
      </div>
    }

    @await Html.PartialAsync("Components/ProductRatings/_RatingForm")
  }
  else
  {
    <div class="alert alert-info">
      <i class="fas fa-info-circle"></i>
      Vui lòng <a href="/Account/Login?returnUrl=@Context.Request.Path" class="alert-link">đăng nhập</a> để đánh giá sản phẩm.
    </div>
  }

  <!-- Ratings List -->
  <div id="ratings-list" class="mt-4">
    @if (Model != null && Model.Any())
    {
      @foreach (var rating in Model)
      {
        @await Html.PartialAsync("Components/ProductRatings/_RatingItem", rating)
      }
    }
    else
    {
      <div class="text-center text-muted py-5">
        <i class="fas fa-star-half-alt fa-3x mb-3"></i>
        <p>Chưa có đánh giá nào. Hãy là người đầu tiên đánh giá sản phẩm này!</p>
      </div>
    }
  </div>

  <!-- Loading Indicator -->
  <div id="ratings-loading" style="display: none;" class="text-center py-3">
    <div class="spinner-border text-warning" role="status">
      <span class="visually-hidden">Đang tải...</span>
    </div>
  </div>

  <!-- Load More Button -->
  @if (Model != null && Model.Count >= 10)
  {
    <div class="text-center mt-3">
      <button class="btn btn-outline-primary" id="btnLoadMoreRatings">
        <i class="fas fa-chevron-down"></i> Xem thêm đánh giá
      </button>
    </div>
  }
</div>

<style>
  .rating-stars i {
    margin: 0 2px;
  }

  .nav-tabs .nav-link {
    color: #6c757d;
  }

    .nav-tabs .nav-link.active {
      color: #ffc107;
      border-bottom: 2px solid #ffc107;
    }

  #ratings-list {
    max-height: 1000px;
    overflow-y: auto;
  }

    #ratings-list::-webkit-scrollbar {
      width: 8px;
    }

    #ratings-list::-webkit-scrollbar-track {
      background: #f1f1f1;
      border-radius: 10px;
    }

    #ratings-list::-webkit-scrollbar-thumb {
      background: #ffc107;
      border-radius: 10px;
    }

      #ratings-list::-webkit-scrollbar-thumb:hover {
        background: #ffb300;
      }
</style>
