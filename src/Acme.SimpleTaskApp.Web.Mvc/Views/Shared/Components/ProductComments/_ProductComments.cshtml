@using Acme.SimpleTaskApp.ProductComments.Dtos
@model List<ProductCommentDto>

@{
    var productId = ViewBag.ProductId as int? ?? 0;
    var isAuthenticated = User.Identity?.IsAuthenticated ?? false;
}
@* @section scripts
{
  <environment names="Development">
    <script src="~/view-resources/Views/Shared/Components/ProductComments/_ProductComments.js" asp-append-version="true"></script>
  </environment>
} *@
<div class="bg-white p-4 rounded mt-3" id="product-comments-section">
    <h4 class="fw-bold mb-4">
        <i class="fas fa-comments"></i> Bình luận sản phẩm
        <span class="badge bg-primary">@(Model?.Count ?? 0)</span>
    </h4>

    @if (isAuthenticated)
    {
        <!-- Comment Form -->
        <div class="comment-form mb-4">
            <div class="card">
                <div class="card-body">
                    <h6 class="card-title">Viết bình luận của bạn</h6>
                    <form id="commentForm">
                        <input type="hidden" id="ProductId" value="@productId" />
                        <input type="hidden" id="ParentCommentId" value="" />
                        
                        <div class="mb-3">
                            <textarea class="form-control" 
                                      id="CommentContent" 
                                      rows="3" 
                                      placeholder="Nhập bình luận của bạn..."
                                      maxlength="1000"></textarea>
                            <small class="text-muted">
                                <span id="charCount">0</span>/1000 ký tự
                            </small>
                        </div>
                        
                        <div class="d-flex justify-content-between align-items-center">
                            <button type="button" 
                                    class="btn btn-secondary btn-sm" 
                                    id="btnCancelReply" 
                                    style="display: none;">
                                <i class="fas fa-times"></i> Hủy trả lời
                            </button>
                            <button type="button" class="btn btn-primary" id="submitComment">
                                <i class="fas fa-paper-plane"></i> Gửi bình luận
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    }
    else
    {
        <div class="alert alert-info">
            <i class="fas fa-info-circle"></i>
            Vui lòng <a href="/Account/Login?returnUrl=@Context.Request.Path" class="alert-link">đăng nhập</a> để bình luận.
        </div>
    }

    <!-- Comments List -->
    <div id="comments-list">
        @if (Model != null && Model.Any())
        {
            @foreach (var comment in Model)
            {
                @await Html.PartialAsync("Components/ProductComments/_CommentItem", comment)
            }
        }
        else
        {
            <div class="text-center text-muted py-5">
                <i class="fas fa-comment-slash fa-3x mb-3"></i>
                <p>Chưa có bình luận nào. Hãy là người đầu tiên bình luận!</p>
            </div>
        }
    </div>

    <!-- Loading Indicator -->
    <div id="comments-loading" style="display: none;" class="text-center py-3">
        <div class="spinner-border text-primary" role="status">
            <span class="visually-hidden">Đang tải...</span>
        </div>
    </div>
</div>



<style>
    .comment-form .card {
        border: 1px solid #e3e6f0;
        box-shadow: 0 0.125rem 0.25rem rgba(0, 0, 0, 0.075);
    }
    
    .comment-form textarea {
        border-radius: 0.5rem;
    }
    
    .comment-form textarea:focus {
        border-color: #4e73df;
        box-shadow: 0 0 0 0.2rem rgba(78, 115, 223, 0.25);
    }
    
    #comments-list {
        max-height: 800px;
        overflow-y: auto;
    }
    
    #comments-list::-webkit-scrollbar {
        width: 8px;
    }
    
    #comments-list::-webkit-scrollbar-track {
        background: #f1f1f1;
        border-radius: 10px;
    }
    
    #comments-list::-webkit-scrollbar-thumb {
        background: #888;
        border-radius: 10px;
    }
    
    #comments-list::-webkit-scrollbar-thumb:hover {
        background: #555;
    }
</style>
