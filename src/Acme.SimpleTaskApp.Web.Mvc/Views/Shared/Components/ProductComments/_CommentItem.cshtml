@using Acme.SimpleTaskApp.ProductComments.Dtos
@model ProductCommentDto

@{
  var currentUserId = User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
  var canEdit = currentUserId != null && Model.UserId.ToString() == currentUserId;
  var isEdited = Model.IsEdited;
}

<div class="comment-item @(Model.ParentCommentId.HasValue ? "is-reply" : "")" data-comment-id="@Model.Id">
  
  <div class="d-flex"></div>
  <div class="comment-body">
    <div class="comment-header">
      <div class="comment-avatar">
        @Model.UserFullName?.Substring(0, 1).ToUpper()
      </div>
      <span class="comment-author">@Model.UserFullName</span>
      <span class="comment-time">
        @Model.CreationTime.ToString("dd/MM/yyyy HH:mm")
        @if (isEdited)
        {
          <span class="edited-badge">• đã sửa</span>
        }
      </span>

      @if (canEdit)
      {
        <div class="comment-menu">
          <button class="btn-edit-comment" type="button" data-comment-id="@Model.Id">
            <i class="fas fa-pen"></i>
          </button>
          <button class="btn-delete-comment" type="button" data-comment-id="@Model.Id">
            <i class="fas fa-trash"></i>
          </button>
        </div>
      }
    </div>

    <!-- Content -->
    <div class="comment-content" data-comment-id="@Model.Id">
      <p class="comment-text">@Model.Content</p>
    </div>

    <!-- Edit Form -->
    <div class="comment-edit-form" style="display: none;">
      <textarea class="edit-textarea" rows="2" maxlength="1000">@Model.Content</textarea>
      <div class="edit-actions">
        <button class="btn-save-edit" data-comment-id="@Model.Id">Lưu</button>
        <button class="btn-cancel-edit">Hủy</button>
      </div>
    </div>

    <!-- Actions -->
    @if (User.Identity?.IsAuthenticated ?? false)
    {
      <div class="comment-actions">
        <button class="btn-reply" data-comment-id="@Model.Id" data-user-name="@Model.UserFullName">
          <i class="fas fa-reply"></i> Trả lời
        </button>
      </div>
    }
  </div>
</div>

@* trả lời *@
@if (Model.Replies != null && Model.Replies.Any())
{
  <div class="replies-container">
    @foreach (var reply in Model.Replies)
    {
      @await Html.PartialAsync("Components/ProductComments/_CommentItem", reply)
    }
  </div>
}

<style>
  . comment-item {
    display: flex;
    gap: 12px;
    padding: 12px 0;
    border-bottom: 1px solid #f3f4f6;
  }

    .comment-item:last-child {
      border-bottom: none;
    }

    .comment-item.is-reply {
      margin-left: 48px;
      padding-left: 16px;
      border-left: 2px solid #e5e7eb;
      border-bottom: none;
    }

  .comment-avatar {
    width: 36px;
    height: 36px;
    border-radius: 50%;
    background: linear-gradient(135deg, #6366f1, #8b5cf6);
    color: #fff;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 14px;
    font-weight: 600;
    flex-shrink: 0;
  }

  .comment-body {
    flex: 1;
    min-width: 0;
  }

  .comment-header {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 4px;
    flex-wrap: wrap;
  }

  .comment-author {
    font-size: 13px;
    font-weight: 600;
    color: #1f2937;
  }

  .comment-time {
    font-size: 11px;
    color: #9ca3af;
  }

  .edited-badge {
    color: #60a5fa;
  }

  .comment-menu {
    margin-left: auto;
    display: flex;
    gap: 4px;
  }

  .btn-edit-comment,
  .btn-delete-comment {
    background: none;
    border: none;
    color: #9ca3af;
    cursor: pointer;
    padding: 6px 8px;
    border-radius: 4px;
    font-size: 14px;
    transition: all 0.2s;
  }

  .btn-edit-comment:hover {
    background: #f3f4f6;
    color: #3b82f6;
  }

  .btn-delete-comment:hover {
    background: #fef2f2;
    color: #ef4444;
  }

  .comment-content {
    margin-bottom: 6px;
  }

  .comment-text {
    margin: 0;
    font-size: 14px;
    color: #374151;
    line-height: 1.5;
    word-wrap: break-word;
  }

  /* Edit Form */
  . comment-edit-form {
    margin-top: 8px;
  }

  .edit-textarea {
    width: 100%;
    padding: 8px 12px;
    border: 1px solid #d1d5db;
    border-radius: 8px;
    font-size: 14px;
    resize: none;
    outline: none;
    transition: border-color 0.2s;
  }

    .edit-textarea:focus {
      border-color: #3b82f6;
    }

  .edit-actions {
    display: flex;
    gap: 8px;
    margin-top: 8px;
  }

  .btn-save-edit {
    background: #3b82f6;
    color: #fff;
    border: none;
    padding: 6px 12px;
    border-radius: 6px;
    font-size: 12px;
    cursor: pointer;
    transition: background 0.2s;
  }

    .btn-save-edit:hover {
      background: #2563eb;
    }

  .btn-cancel-edit {
    background: #f3f4f6;
    color: #6b7280;
    border: none;
    padding: 6px 12px;
    border-radius: 6px;
    font-size: 12px;
    cursor: pointer;
  }

    .btn-cancel-edit:hover {
      background: #e5e7eb;
    }

  /* Actions */
  .comment-actions {
    margin-top: 4px;
  }

  .btn-reply {
    background: none;
    border: none;
    color: #6b7280;
    font-size: 12px;
    cursor: pointer;
    padding: 4px 8px;
    border-radius: 4px;
    transition: all 0.2s;
  }

    .btn-reply:hover {
      background: #f3f4f6;
      color: #3b82f6;
    }

    .btn-reply i {
      margin-right: 4px;
    }

  /* Replies Container */
  .replies-container {
    margin-left: 48px;
  }
</style>