@using Acme.SimpleTaskApp.Web.Views.Shared.Components.User
@model UserViewModel

@if (Model.LoginInformations.User == null)
{
  <div class="d-flex">
    <a class="nav-link" href="/Account/Register" style="padding-right: 15px;">
      <i class="fas fa-user-plus "></i> Đăng ký
    </a>

    <a asp-controller="Account" asp-action="Login" class="nav-link d-flex align-items-center">
      <i class="fas fa-user-circle fs-4"></i>
      <span class="ms-2">Đăng nhập</span>
    </a>
  </div>
}
else
{
  <div class="d-flex align-items-center dropdown" id="userDropdownContainer">
    <img src="~/img/Avatar/avatar5.png" style="width: 35px; height:35px" class="img-circle elevation-2 me-2" alt="User Image">
    <a class="text-black dropdown-toggle" href="#" role="button" id="userDropdown" data-bs-toggle="dropdown" aria-expanded="false">
      @Html.Raw(Model.GetShownLoginName())
    </a>
    <ul class="dropdown-menu dropdown-menu-end user-dropdown-menu" aria-labelledby="userDropdown">
      <li><a class="dropdown-item" href="/UserProfile"><i class="fas fa-user me-2"></i>Thông tin tài khoản</a></li>
      <li><hr class="dropdown-divider"></li>
      <li><a class="dropdown-item text-danger" href="/HomeCustomer/SignOut"><i class="fas fa-sign-out-alt me-2"></i>Đăng xuất</a></li>
    </ul>
  </div>

  <style>
    .user-dropdown-menu {
      background-color: #fff !important;
      border: 1px solid rgba(0,0,0,.15) !important;
      box-shadow: 0 0.5rem 1rem rgba(0, 0, 0, 0.15) !important;
      min-width: 200px !important;
    }

      .user-dropdown-menu .dropdown-item {
        color: #212529 !important;
        padding: 0.5rem 1rem !important;
      }

        .user-dropdown-menu .dropdown-item:hover {
          background-color: #f8f9fa !important;
          color: #16181b !important;
        }

        .user-dropdown-menu .dropdown-item.text-danger:hover {
          background-color: #dc3545 !important;
          color: white !important;
        }

    /* Hover functionality */
    #userDropdownContainer:hover .user-dropdown-menu {
      display: block !important;
      opacity: 1 !important;
      visibility: visible !important;
      transform: translateY(0) !important;
    }
  </style>

  <script>
    document.addEventListener('DOMContentLoaded', function() {
      const dropdownContainer = document.getElementById('userDropdownContainer');
      const dropdownMenu = dropdownContainer.querySelector('.user-dropdown-menu');

      // Force show on hover
      dropdownContainer.addEventListener('mouseenter', function() {
        dropdownMenu.style.display = 'block';
        dropdownMenu.style.opacity = '1';
        dropdownMenu.style.visibility = 'visible';
      });

      dropdownContainer.addEventListener('mouseleave', function() {
        setTimeout(() => {
          if (!dropdownContainer.matches(':hover')) {
            dropdownMenu.style.display = 'none';
          }
        }, 200);
      });
    });
  </script>
}