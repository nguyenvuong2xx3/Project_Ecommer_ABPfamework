﻿@using Acme.SimpleTaskApp.Web.Views.Shared.Components.ProductList
@using static Acme.SimpleTaskApp.Products.Product
@model ProductListViewModel
<div class="main-container mt-3" style="height: 550px">

  <div class="products-header">
    <h3>Sản phẩm mới nhất</h3>
  </div>

  <div class="layout-container">

    <div class="banner-container">
      @if (Model.Banner != null)
      {
        <div class="banner-image-slider">
          <img src="@Model.Banner.ImageUrl" class="banner-image" alt="Banner" style="height: 410px; width: 370px;">
        </div>
      }
      else
      {
        <div class="banner-placeholder banner-image-slider">
          <h4>Banner Quảng Cáo</h4>
          <p>Ưu đãi đặc biệt trong tháng này</p>
        </div>
      }
    </div>

    <div class="products-container">

      <div id="productCarousel" class="carousel slide" data-ride="carousel" data-interval="false">
        <div class="carousel-inner">
          @{
            var validProducts = Model.ProductsInfo
            .Select(p => new { Product = p, FirstVariant = p.ProductVariants.FirstOrDefault() })
            .Where(p => p.FirstVariant != null)
            .ToList();

            int productsPerPage = 4;
            int pageCount = (int)Math.Ceiling((double)validProducts.Count / productsPerPage);

            for (int page = 0; page < pageCount; page++)
            {
              var productsOnThisPage = validProducts.Skip(page * productsPerPage).Take(productsPerPage);
              var isActive = (page == 0) ? "active" : "";

              <div class="carousel-item @isActive">
                <div class="products-grid product-create">
                  @foreach (var p in productsOnThisPage)
                  {
                    var product = p.Product;
                    var item = p.FirstVariant;

                    <div class="product-item">
                      <div class="product-card productvariant-click-detail cursor" data-id="@item.Id">
                        <!-- Discount Badge -->
                        @if (item.HasActiveDiscount && item.DiscountPercentage > 0)
                        {
                          <div class="discount-badge">
                            <i class="fas fa-bolt"></i> -@item.DiscountPercentage.ToString("0.#")%
                          </div>
                        }

                        <div class="image-container">
                          @if (item.ImageUrl != null)
                          {
                            <img src="@item.ImageUrl" class="product-image" alt="@product.Name">
                          }
                          else
                          {
                            <img src="~/img/products/default.png" class="product-image" alt="@product.Name">
                          }
                        </div>

                        <div class="product-info">
                          <div class="product-name">
                            @product.Name
                          </div>

                          <div class="product-tags">
                            @if (!string.IsNullOrEmpty(item.Ram))
                            {
                              <span class="product-tag">@item.Ram</span>
                            }
                            @if (!string.IsNullOrEmpty(item.Storage))
                            {
                              <span class="product-tag">@item.Storage</span>
                            }
                            @if (!string.IsNullOrEmpty(item.Color))
                            {
                              <span class="product-tag">@item.Color</span>
                            }
                          </div>

                          <div class="product-price">
                            @if (item.HasActiveDiscount && item.DiscountPercentage > 0)
                            {
                              <!-- Giá gốc gạch ngang -->
                              <div class="original-price">@item.Price.ToString("#,##0")₫</div>
                              <!-- Giá sau giảm -->
                              <div class="current-price">@item.DiscountedPrice.ToString("#,##0")₫</div>
                            }
                            else
                            {
                              <!-- Giá bình thường -->
                              <div class="current-price">@item.Price.ToString("#,##0")₫</div>
                            }
                          </div>
                          <!-- đánh giá sao -->
                          @if (item.TotalRatings > 0)
                          {
                            <div class="product-rating mb-2">
                              <div class="rating-stars">
                                @for (int i = 1; i <= 5; i++)
                                {
                                  if (i <= Math.Floor(item.AverageRating))
                                  {
                                    <i class="fas fa-star text-warning"></i>
                                  }
                                  else if (i <= Math.Ceiling(item.AverageRating))
                                  {
                                    <i class="fas fa-star-half-alt text-warning"></i>
                                  }
                                  else
                                  {
                                    <i class="far fa-star text-warning"></i>
                                  }
                                }
                              </div>
                              <span class="rating-text">@item.AverageRating.ToString("0.0") (@item.TotalRatings)</span>
                            </div>
                          }
                          <!-- Stock Quantity -->
                          <div class="stock-status">
                            @if (item.StockQuantity == 0)
                            {
                              <div class="sold-out-overlay">
                                <i class="fas fa-ban"></i>
                                Hết hàng
                              </div>
                            }
                          </div>
                        </div>
                        <div class="sold-info" style="margin: 0px;">
                          <i class="fas fa-shopping-bag"></i>
                          <span class="sold-text">Đã bán <strong>@item.SoldQuantity</strong></span>
                        </div>
                      </div>
                    </div>
                  }
                </div>
              </div>
            }
          }
        </div>

        @if (pageCount > 1)
        {
          <a class="carousel-control-prev product-carousel-control" href="#productCarousel" role="button" data-slide="prev">
            <span class="carousel-control-prev-icon" aria-hidden="true"></span>
            <span class="sr-only">Previous</span>
          </a>
          <a class="carousel-control-next product-carousel-control" href="#productCarousel" role="button" data-slide="next">
            <span class="carousel-control-next-icon" aria-hidden="true"></span>
            <span class="sr-only">Next</span>
          </a>
        }
      </div>
    </div>
  </div>
</div>

<style>


  .product-rating.mb-2 .rating-stars {
    display: inline-block;
    font-size: 1em;
  }

  .sold-info {
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 8px 15px;
    font-size: 12px;
    color: #666;
    border-bottom: 1px solid #f0f0f0;
    margin: 8px 0;
    background-color: #fafafa;
  }

    .sold-info i {
      color: #288ad6;
      font-size: 11px;
    }

  .sold-text {
    font-weight: 400;
  }

    .sold-text strong {
      color: #d0021b;
      font-weight: 600;
    }

  .product-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 5px;
    margin-bottom: 10px;
  }

  .product-tag {
    background-color: #e4e1e1;
    color: #555;
    padding: 3px 8px;
    border-radius: 12px;
    font-size: 11px;
    font-weight: 500;
    white-space: nowrap;
  }

  /* Điều chỉnh lại product name */
  .product-name {
    font-size: 14px;
    font-weight: 500;
    color: #444;
    height: 40px;
    overflow: hidden;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    line-height: 1.4;
    margin-bottom: 8px;
  }

  .sold-out-overlay {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 160px;
    background: rgba(173, 173, 173, 0.5);
    color: #000;
    font-size: 16px;
    font-weight: 700;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 6px;
    border-bottom: 1px solid #f3f3f3;
  }

    .sold-out-overlay i {
      font-size: 22px;
    }

  /* Main Container Styling */
  .main-container {
    width: 1200px;
    background-color: white;
    margin: 0 auto;
    padding: 20px;
    box-sizing: border-box;
    border-radius: 15px;
  }

  .products-header {
    padding-bottom: 25px;
    border-bottom: 1px solid #eee;
    margin-bottom: 20px;
  }

    .products-header h3 {
      font-size: 24px;
      font-weight: 700;
      color: #444;
      margin: 0;
      text-transform: uppercase;
    }

  /* Layout container */
  .layout-container {
    display: flex;
    gap: 20px;
  }

  /* Products Container */
  .products-container {
    width: 75%;
    position: relative;
  }

  /* Products Grid */
  .product-create {
    justify-content: center;
    margin: 0px auto;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 15px;
  }

  /* Product Item */
  .product-item {
    height: 409px;
    margin: 0;
  }
  /* NEW: Discount Badge */
  .discount-badge {
    position: absolute;
    top: 10px;
    right: 10px;
    background: linear-gradient(135deg, #ff6b6b 0%, #ee5a6f 100%);
    color: white;
    padding: 6px 10px;
    border-radius: 20px;
    font-size: 12px;
    font-weight: 700;
    z-index: 10;
    box-shadow: 0 2px 8px rgba(255, 107, 107, 0.4);
    display: flex;
    align-items: center;
    gap: 4px;
  }

    .discount-badge i {
      font-size: 10px;
      animation: pulse 1.5s infinite;
    }

  @@keyframes pulse {
    0%, 100% {
      transform: scale(1);
    }

    50% {
      transform: scale(1.2);
    }
  }

  /* Image Container */
  .image-container {
    width: 100%;
    height: 160px;
    display: flex;
    justify-content: center;
    align-items: center;
    overflow: hidden;
    background-color: white;
    border-bottom: 1px solid #f3f3f3;
    padding: 15px;
    box-sizing: border-box;
  }

  .product-image {
    width: auto;
    height: auto;
    object-fit: cover;
  }

  /* Product Info */
  .product-info {
    padding: 15px 15px 0 15px;
    flex-grow: 1;
    background-color: white;
    box-sizing: border-box;
  }

  /* Price Styling */
  .product-price {
    margin-bottom: 10px;
  }

  /* NEW: Original Price (strikethrough) */
  .original-price {
    font-size: 13px;
    font-weight: 400;
    color: #999;
    text-decoration: line-through;
    margin-bottom: 4px;
  }

  .current-price {
    font-size: 16px;
    font-weight: 700;
    color: #d0021b;
    margin-bottom: 5px;
  }


  /* Style cho các nút của Product Carousel */
  #productCarousel .carousel-control-prev,
  #productCarousel .carousel-control-next {
    width: 40px;
    height: 40px;
    background-color: rgba(0, 0, 0, 0.2);
    border-radius: 50%;
    top: 50%;
    transform: translateY(-50%);
  }

  #productCarousel .carousel-control-prev {
    left: -20px;
  }

  #productCarousel .carousel-control-next {
    right: -20px;
  }

  #productCarousel .carousel-control-prev-icon,
  #productCarousel .carousel-control-next-icon {
    filter: invert(1) grayscale(100);
  }

  /* Banner Container */
  .banner-container {
    width: 25%;
  }
</style>