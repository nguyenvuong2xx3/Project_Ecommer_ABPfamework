@using Acme.SimpleTaskApp.Web.Views.Shared.Components.BannerHomeTop
@model BannerHomeTopViewModel

<div class="container-fluid hero-header" style="background-color: #f8f9fa;">
  <div class="container d-flex justify-content-center align-items-center"
       min-height: 406px;">
    <div class="col-lg-10">
      <div id="carouselId" class="carousel slide rounded overflow-hidden shadow" data-bs-ride="carousel">
        <div class="carousel-inner">
          @if (Model.Banners != null && Model.Banners.Any())
          {
            foreach (var banner in Model.Banners)
            {
              var isActive = banner == Model.Banners.First() ? "active" : "";
              <div class="carousel-item @isActive">
                <img src="@banner.ImageUrl" class="d-block w-100" style="height: 300px; object-fit: cover;" alt="Banner slide">
              </div>
            }
          }
        </div>
        <button class="carousel-control-prev" type="button" data-bs-target="#carouselId" data-bs-slide="prev">
          <span class="carousel-control-prev-icon" aria-hidden="true"></span>
          <span class="visually-hidden">Previous</span>
        </button>
        <button class="carousel-control-next" type="button" data-bs-target="#carouselId" data-bs-slide="next">
          <span class="carousel-control-next-icon" aria-hidden="true"></span>
          <span class="visually-hidden">Next</span>
        </button>
      </div>
    </div>
  </div>
</div>

