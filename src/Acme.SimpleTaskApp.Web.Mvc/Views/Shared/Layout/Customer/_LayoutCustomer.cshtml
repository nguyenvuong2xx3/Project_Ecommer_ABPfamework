@using Abp.Configuration.Startup
@using Abp.Web.Mvc.Alerts
@using Abp.Web.Security.AntiForgery
@using Acme.SimpleTaskApp.Web.Resources
@using Abp.Configuration
@using Acme.SimpleTaskApp.Configuration
@inject IAbpAntiForgeryManager AbpAntiForgeryManager
@inject IMultiTenancyConfig MultiTenancyConfig
@inject IWebResourceManager WebResourceManager
@inject IAlertManager AlertManager
@inject ILanguageManager LanguageManager
@inject ISettingManager SettingManager
@{
	AbpAntiForgeryManager.SetCookie(Context);

	var storeName = await SettingManager.GetSettingValueAsync(AppNameStore.NameStore);
	if (string.IsNullOrWhiteSpace(storeName))
	{
		storeName = "Shop";
	}

	var pageTitle = !string.IsNullOrWhiteSpace(ViewBag.Title) ? ViewBag.Title + " - " : "";
	pageTitle += storeName;
}

<!DOCTYPE html>
<html lang="@LanguageManager.CurrentLanguage.Name">
<head>
	<meta charset="utf-8">
	<meta name="viewport" content="width=device-width, initial-scale=1">
	<meta http-equiv="x-ua-compatible" content="ie=edge">

	<title>@pageTitle</title>

	@await Html.PartialAsync("_Styles.cshtml")
	@RenderSection("styles", required: false)
</head>
<body class="hold-transition sidebar-mini">
	@await Html.PartialAsync("_Alerts.cshtml")
	@await Html.PartialAsync("~/Views/Shared/Layout/Customer/_NavbarCustomer.cshtml")
	<div style="margin-top:102px">
		@RenderBody()
	</div>
	@await Html.PartialAsync("~/Views/Shared/Layout/Customer/_FooterCustomer.cshtml")

	@* ✅ AI Chatbot Widget *@
	@* @await Html.PartialAsync("~/Views/Shared/Components/Chatbot/_ChatbotWidget.cshtml") *@

	@await Html.PartialAsync("_Scripts.cshtml")
	@RenderSection("scripts", required: false)
	@WebResourceManager.RenderScripts()
	<a href="#" class="btn btn-primary border-3 border-primary rounded-circle back-to-top"><i class="fa fa-arrow-up m-0"></i></a>
	<script src="~/view-resources/Views/HomeCustomer/mainCustomer.js"></script>
	@* ✅ Chatbot Widget Script *@
	@* <script src="~/view-resources/Views/Shared/Components/Chatbot/_ChatbotWidget.js"></script> *@
</body>
</html>
