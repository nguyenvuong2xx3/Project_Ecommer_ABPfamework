﻿@using Acme.SimpleTaskApp.Web.Views.Shared.Components.AppTrezoRecentNotifications
@using Abp.Configuration
@using Acme.SimpleTaskApp.Configuration
@inject ISettingManager SettingManager

@{
  var storeName = await SettingManager.GetSettingValueAsync(AppNameStore.NameStore);
  var logoUrl = await SettingManager.GetSettingValueAsync(AppNameStore.UrlLogo);
  var isConfigured = !string.IsNullOrWhiteSpace(storeName) || !string.IsNullOrWhiteSpace(logoUrl);
}

<div class="container-fluid fixed-top shadow bg-white">
  <nav class="navbar navbar-light navbar-expand-xl w-100" style="position: relative; z-index: 1040;">
    <!-- Logo - Đã sửa để hiển thị động -->
    <a asp-controller="HomeCustomer" asp-action="Index" class="navbar-brand d-flex align-items-center">
      @if (isConfigured)
      {
        @if (!string.IsNullOrWhiteSpace(logoUrl))
        {
          <div class="brand-logo-container me-2">
            <img src="@logoUrl" alt="@storeName"
                 class="brand-image img-circle elevation-1"
                 style="max-height: 45px; width: auto; object-fit: contain; box-shadow: none !important;"
                 onerror="this.style.display='none'; this.nextElementSibling?.style.display='inline';">
            <i class="fas fa-store text-primary" style="display: none; font-size: 1.8rem;"></i>
          </div>
        }
        else
        {
          <div class="brand-logo-container me-2">
            <i class="fas fa-store text-primary" style="font-size: 1.8rem;"></i>
          </div>
        }

        @if (!string.IsNullOrWhiteSpace(storeName))
        {
          <span class="brand-text text-primary fw-bold fs-4">@storeName</span>
        }
        else
        {
          <span class="brand-text text-primary fw-bold fs-4">Cửa Hàng</span>
        }
      }
      else
      {
        <div class="brand-logo-container me-2">
          <i class="fas fa-exclamation-triangle text-warning" style="font-size: 1.8rem;"></i>
        </div>
        <span class="brand-text text-warning fw-bold fs-6">Chưa cấu hình cửa hàng</span>
      }
    </a>

    <!-- Thanh tìm kiếm -->
    <div class="d-flex align-items-center me-3">
      <input class="form-control txt-search" name="Keyword" type="text" placeholder="Bạn tìm gì?">
      <button class="btn" id="searchButton">
        <i class="fas fa-search text-success"></i>
      </button>
    </div>

    <!-- Nút toggle menu -->
    <button class="navbar-toggler py-2 px-3" type="button" data-bs-toggle="collapse" data-bs-target="#navbarCollapse">
      <span class="fa fa-bars text-primary"></span>
    </button>

    <!-- Nội dung menu -->
    <div class="collapse navbar-collapse w-100" id="navbarCollapse">
      <div class="navbar-nav mx-auto">
        @* <a asp-controller="HomeCustomer" asp-action="Index" class="nav-item nav-link active">Home</a>
        <div class="nav-item dropdown">
          <a href="#" class="nav-link dropdown-toggle" data-bs-toggle="dropdown">Pages</a>
          <div class="dropdown-menu m-0 bg-secondary rounded-0">
            <a href="cart.html" class="dropdown-item">Cart</a>
            <a href="checkout.html" class="dropdown-item">Checkout</a>
            <a href="testimonial.html" class="dropdown-item">Testimonial</a>
            <a href="404.html" class="dropdown-item">404 Page</a>
          </div>
        </div>
        <a href="contact.html" class="nav-item nav-link">Contact</a> *@
      </div>



      <!-- Giỏ hàng và Đăng nhập -->
      <div class="d-flex align-items-center cart-login" style="padding-right: 192px">
        @* thông báo *@
        @await Component.InvokeAsync(typeof(AppTrezoRecentNotificationsViewComponent), new
        {
          cssClass = "btn btn-icon btn-active-light-primary position-relative w-30px h-30px w-md-40px h-md-40px"
        })
        @if (AbpSession.UserId.HasValue)
        {
          @await Component.InvokeAsync("CartMenu")
        }
        @await Component.InvokeAsync("User")
      </div>
    </div>
  </nav>
  @await Component.InvokeAsync("CategoryList", new { viewName = "CategoryListIndex" })

</div>

<style>

  .header-right-item::marker {
    content: "";
  }

  /* ===== STYLING CHO 3 NÚT: GIỎ HÀNG, ĐĂNG KÝ, ĐĂNG NHẬP ===== */

  /* Container chung cho các nút */
  .cart-login {
    display: flex;
    align-items: center;
    gap: 12px;
    padding-right: 192px;
  }

  /* Style chung cho tất cả các nút action */
  .btn-nav-action {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 10px 18px;
    border-radius: 50px;
    font-size: 14px;
    font-weight: 600;
    text-decoration: none;
    transition: all 0. 3s ease;
    border: 2px solid transparent;
    cursor: pointer;
  }


  @@keyframes pulse-badge {
    0%, 100% {
      transform: scale(1);
    }

    50% {
      transform: scale(1.1);
    }
  }

  50% {
    transform: scale(1.1);
  }

  }

  /* ===== NÚT ĐĂNG KÝ ===== */
  .btn-register {
    background: transparent;
    color: #28a745 !important;
    border: 2px solid #28a745;
  }

    .btn-register:hover {
      background: #28a745;
      color: #fff !important;
      transform: translateY(-2px);
      box-shadow: 0 4px 15px rgba(40, 167, 69, 0. 4);
    }

    . btn-register i {
      font-size: 16px;
    }

  /* ===== NÚT ĐĂNG NHẬP ===== */
  .btn-login {
    background: linear-gradient(135deg, #f093fb 0%, #f5576c 100%);
    color: #fff !important;
    box-shadow: 0 4px 15px rgba(245, 87, 108, 0.4);
  }

    . btn-login:hover {
      background: linear-gradient(135deg, #f5576c 0%, #f093fb 100%);
      transform: translateY(-2px);
      box-shadow: 0 6px 20px rgba(245, 87, 108, 0. 5);
      color: #fff !important;
    }

    .btn-login i {
      font-size: 16px;
    }

  /* Text trong các nút */
  . btn-text {
    white-space: nowrap;
  }

  /* ===== RESPONSIVE ===== */
  @@media (max-width: 1200px) {
    .cart-login {
      gap: 8px;
      padding-right: 100px;
    }

    .btn-nav-action {
      padding: 8px 14px;
      font-size: 13px;
    }
  }

  @@media (max-width: 992px) {
    .btn-nav-action .btn-text {
      display: none;
    }

    .btn-nav-action {
      padding: 10px 12px;
      border-radius: 50%;
    }

    .cart-login {
      gap: 6px;
    }
  }

  .btn-nav-action {
    padding: 10px 12px;
    border-radius: 50%;
  }

  .cart-login {
    gap: 6px;
  }

  }

  @@media (max-width: 768px) {
    .cart-login {
      padding-right: 20px;
      flex-wrap: wrap;
      justify-content: center;
    }

    .btn-nav-action .btn-text {
      display: inline;
    }

    .btn-nav-action {
      padding: 8px 12px;
      font-size: 12px;
      border-radius: 25px;
    }
  }

  .btn-nav-action . btn-text {
    display: inline;
  }

  .btn-nav-action {
    padding: 8px 12px;
    font-size: 12px;
    border-radius: 25px;
  }

  }

  li.header-right-item {
    list-style-type: none !important;
  }

  /* Brand logo container */
  .brand-logo-container {
    display: flex;
    align-items: center;
    justify-content: center;
    min-width: 45px;
    min-height: 45px;
  }

  /* Brand logo image */
  .brand-image {
    transition: all 0.3s ease;
    border-radius: 8px;
  }

    .brand-image:hover {
      transform: scale(1.05);
      opacity: 0.9;
    }

  /* Brand text */
  .brand-text {
    transition: color 0.3s ease;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    max-width: 200px;
  }

  .navbar-brand:hover .brand-text {
    color: #0056b3 !important;
  }

  /* Thanh tìm kiếm */
  .txt-search {
    font-size: 14px;
    border: 2px solid #f0ad4e;
    border-radius: 50px;
    padding: 8px 12px;
    width: 180px;
    outline: none;
    transition: border-color 0.3s ease;
  }

    .txt-search:focus {
      border-color: #ffc107;
    }

  #searchButton {
    border: 2px solid #f0ad4e;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    display: flex;
    justify-content: center;
    align-items: center;
    transition: background-color 0.3s ease;
  }

    #searchButton:hover {
      background-color: #f8f9fa;
    }

  /* Navbar */
  .navbar {
    padding: 8px 16px;
  }

  /* Logo container */
  .navbar-brand {
    display: flex;
    align-items: center;
    padding-left: 192px;
    text-decoration: none;
  }

  /* Căn chỉnh giỏ hàng và đăng nhập */
  .nav-link {
    font-size: 16px;
    color: #333;
    display: flex;
    align-items: center;
  }

    .nav-link i {
      font-size: 24px;
    }

  .badge {
    font-size: 12px;
    padding: 3px 6px;
  }

  .cart-login {
    padding-right: 180px;
  }

  /* Fix z-index cho notification dropdown - phải cao hơn mọi thứ */
  #header_notification_bar {
    position: relative;
    z-index: 1070;
  }

    #header_notification_bar .dropdown {
      position: static !important;
    }

    #header_notification_bar .dropdown-menu {
      position: fixed !important;
      z-index: 1070 !important;
    }

  /* Đảm bảo category dropdown thấp hơn notification */
  .menu-category {
    position: relative;
    z-index: 1000;
  }

    .menu-category .dropdown-menu {
      z-index: 1000;
    }

    .menu-category .sub-dropdown {
      z-index: 1001;
    }

  .dropdown-menu.dropdown-menu-right.p-0.border-0.shadow.show {
    visibility: visible !important; /* Đảm bảo thuộc tính này được ưu tiên */
    opacity: 1 !important; /* Đảm bảo thuộc tính này được ưu tiên */
  }

  /* Responsive adjustments */
  @@media (max-width: 1200px) {
    .navbar-brand {
      padding-left: 100px;
    }

    .cart-login {
      padding-right: 100px;
    }

    .brand-text {
      max-width: 150px;
    }
  }

  @@media (max-width: 768px) {
    .navbar-brand {
      padding-left: 20px;
    }

    .cart-login {
      padding-right: 20px;
    }

    .brand-text {
      max-width: 120px;
      font-size: 1.1rem !important;
    }

    .brand-logo-container {
      min-width: 35px;
      min-height: 35px;
    }

    .brand-image {
      max-height: 35px !important;
    }
  }
</style>