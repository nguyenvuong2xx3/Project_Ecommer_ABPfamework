﻿@using Acme.SimpleTaskApp.Web.Models.UserProfiles
@model UserProfileViewModel
@{
  ViewData["Title"] = "Index";
  Layout = "~/Views/Shared/Layout/Customer/_LayoutCustomer.cshtml";
}

@section scripts
{
  <environment names="Development">
    <script src="~/view-resources/Views/UserProfiles/Index.js" asp-append-version="true"></script>
  </environment>
}

<div class="container">
  <div class="row  pt-3">
    <div class="col-md-3">
      <div class="account-sidebar">
        <h4>@Model.User.FullName</h4>
        <ul class="nav flex-column" id="accountTab" role="tablist">
          <li class="nav-item" role="presentation">
            <a class="nav-link active" id="orders-tab" data-bs-toggle="tab" data-bs-target="#orders-tab-pane" role="tab" aria-controls="orders-tab-pane" aria-selected="true">
              <i class="fas fa-box"></i>
              Đơn hàng đã mua
            </a>
          </li>
          <li class="nav-item" role="presentation">
            <a class="nav-link" id="info-tab" data-bs-toggle="tab" data-bs-target="#info-tab-pane" role="tab" aria-controls="info-tab-pane" aria-selected="false">
              <i class="fas fa-map-marker-alt"></i>
              Thông tin và số địa chỉ
            </a>
          </li>
        </ul>
        <hr />
        <button class="btn logout-btn">Đăng Xuất</button>
      </div>
    </div>

    <!-- Cột bên phải (Nội dung các Tab) -->
    <div class="col-md-9">
      <div class="tab-content" id="accountTabContent">

        <!-- 1. Nội dung cho Tab "Đơn hàng đã mua" -->
        <!-- 1. Nội dung cho Tab "Đơn hàng đã mua" -->
        <!-- 1. Nội dung cho Tab "Đơn hàng đã mua" -->
        <div class="tab-pane fade show active" id="orders-tab-pane" role="tabpanel" aria-labelledby="orders-tab">
          <div class="d-flex justify-content-between align-items-center mb-3">
            <h4 class="mb-0">Đơn hàng đã mua</h4>
            <div>
              <div class="d-flex align-items-center gap-2">
                <label for="StartEndRange" class="form-label mb-0">Thời gian đặt hàng</label>
                <input id="StartEndRange" autocomplete="off" type="text" class="form-control date-range-picker" placeholder="Chọn khoảng thời gian đặt hàng.." name="Thời gian đặt hàng" style="width: 200px" />

                <label for="PaymentMethod" class="form-label mb-0">Hình thức thanh toán</label>
                <select class="form-select" id="PaymentMethod" name="PaymentMethod" style="width: 200px">
                  <option value="">Tất cả</option>
                  <option value="0">Thanh toán khi nhận hàng</option>
                  <option value="1">Chuyển khoản ngân hàng</option>
                  <option value="2">Ví điện tử</option>
                  <option value="3">Thẻ tín dụng</option>
                </select>

                <button id="ResetFilters" class="btn btn-outline-secondary btn-sm">
                  <i class="fas fa-refresh"></i> Reset
                </button>
              </div>
            </div>
          </div>

          <ul class="nav nav-pills mb-4 order-status-filters">
            <li class="nav-item"><a href="#" class="nav-link active" data-status="all">Tất cả</a></li>
            <li class="nav-item"><a href="#" class="nav-link" data-status="0">Chờ xác nhận</a></li>
            <li class="nav-item"><a href="#" class="nav-link" data-status="1">Đang xử lý</a></li>
            <li class="nav-item"><a href="#" class="nav-link" data-status="2">Đang giao hàng</a></li>
            <li class="nav-item"><a href="#" class="nav-link" data-status="3">Thành công</a></li>
            <li class="nav-item"><a href="#" class="nav-link" data-status="4">Đã hủy</a></li>
            <li class="nav-item"><a href="#" class="nav-link" data-status="5">Hoàn trả</a></li>
          </ul>

          <!-- Container cho danh sách đơn hàng -->
          <div class="orders-list-container">
            <!-- Nội dung đơn hàng sẽ được render bằng JavaScript -->
          </div>

          <!-- Container hiển thị khi không có đơn hàng -->
          <div class="empty-orders-container">
            <div class="icon"><i class="fas fa-shopping-bag"></i></div>
            <h4>Rất tiếc, không tìm thấy đơn hàng nào phù hợp</h4>
            <p class="text-muted">Vẫn còn rất nhiều sản phẩm đang chờ anh</p>
            <div>
              <a href="#" class="btn btn-outline-primary">Điện thoại</a>
              <a href="#" class="btn btn-outline-primary">Laptop</a>
            </div>
            <div class="mt-4">
              <a href="/"><i class="fas fa-chevron-left"></i> Về trang chủ</a>
            </div>
          </div>
        </div>

        <!-- 2. Nội dung cho Tab "Thông tin và số địa chỉ" -->
        <div class="tab-pane fade" id="info-tab-pane" role="tabpanel" aria-labelledby="info-tab">
          <h3 class="mb-4 fw-bold">Thông tin tài khoản</h3>

          <!-- Form cập nhật thông tin cá nhân -->
          <div class="info-card">
            <h5 class="info-card-header">Thông tin cá nhân</h5>
            <form id="updateProfileForm">
              <input type="hidden" id="UserId" name="UserId" value="@Model.User.Id" />

              <div class="mb-3">
                <div class="form-check form-check-inline">
                  <input class="form-check-input" type="radio" name="GioiTinh" id="genderMale" value="1" @(Model.User.GioiTinh == 1 ? "checked" : "")>
                  <label class="form-check-label" for="genderMale">Anh</label>
                </div>
                <div class="form-check form-check-inline">
                  <input class="form-check-input" type="radio" name="GioiTinh" id="genderFemale" value="0" @(Model.User.GioiTinh == 0 ? "checked" : "")>
                  <label class="form-check-label" for="genderFemale">Chị</label>
                </div>
                <div class="form-check form-check-inline">
                  <input class="form-check-input" type="radio" name="GioiTinh" id="genderOther" value="2" @(Model.User.GioiTinh == 2 ? "checked" : "")>
                  <label class="form-check-label" for="genderOther">Khác</label>
                </div>
              </div>

              <div class="row align-items-end">
                <div class="col-md-6 mb-3">
                  <label for="FullName" class="form-label">Họ & Tên:</label>
                  <input type="text" class="form-control" id="FullName" name="FullName" value="@Model.User.FullName" required>
                </div>
                <div class="col-md-6 mb-3">
                  <label for="PhoneNumber" class="form-label">Số điện thoại:</label>
                  <input type="text" class="form-control" id="PhoneNumber" name="PhoneNumber" value="@Model.User.PhoneNumber">
                </div>
                <h5 class="info-card-header">Địa chỉ nhận hàng</h5>

                <div class="col-md-6 mb-3">
                  <select class="form-select" id="TinhThanh" name="TinhThanh">
                    <option value="">Chọn Tỉnh/Thành phố</option>
                    @if (!string.IsNullOrEmpty(Model.User.TinhThanh))
                    {
                      <option value="@Model.User.TinhThanh" selected>@Model.TenTinhThanh</option>
                    }
                  </select>
                </div>
                <div class="col-md-6 mb-3">
                  <select class="form-select" id="PhuongXa" name="PhuongXa">
                    <option value="">Chọn Phường/Xã</option>
                    @if (!string.IsNullOrEmpty(Model.User.PhuongXa))
                    {
                      <option value="@Model.User.PhuongXa" selected>@Model.TenPhuongXa</option>
                    }
                  </select>
                </div>
                <div class="mb-3">
                  <input type="text" class="form-control" id="DiaChiChiTiet" name="DiaChiChiTiet" placeholder="Số Nhà, Tên Đường*" value="@Model.User.DiaChiChiTiet">
                </div>
                <div class="col-md-12 mb-6 text-end cancel-save-links">
                  <button type="button" id="cancelProfileEdit" class="btn btn-link text-decoration-none p-0">Hủy</button>
                  <button type="button" id="saveProfile" class="btn btn-link text-decoration-none p-0">Lưu</button>
                </div>
              </div>
              <div class="form-check mb-4">
                <input class="form-check-input" type="checkbox" id="IsDiaChiMacDinh" name="IsDiaChiMacDinh" @(Model.User.IsDiaChiMacDinh == 1 ? "checked" : "")>
                <label class="form-check-label" for="IsDiaChiMacDinh">Đặt làm địa chỉ mặc định</label>
              </div>
            </form>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<style>

  /* CSS cho đơn hàng dạng vắn tắt */
  .order-card {
    border: 1px solid #e9ecef;
    border-radius: 8px;
    transition: box-shadow 0.2s ease;
    margin-bottom: 12px;
  }

    .order-card:hover {
      box-shadow: 0 2px 8px rgba(0,0,0,0.1);
    }

    .order-card .card-body {
      padding: 12px 16px;
    }

  .badge {
    font-size: 0.7em;
    padding: 3px 6px;
    border-radius: 4px;
  }

  .order-detail-content {
    background-color: #f8f9fa;
    border-radius: 6px;
    padding: 12px;
    font-size: 0.9em;
  }

  .order-detail-item {
    background-color: white;
    border-radius: 4px;
    margin-bottom: 6px;
    font-size: 0.9em;
  }

  .btn-sm {
    padding: 2px 8px;
    font-size: 0.8em;
  }

  /* Ẩn container mặc định */
  .orders-list-container {
    display: none;
  }

  .empty-orders-container {
    display: none;
  }

  /* Layout cho bộ lọc */
  .gap-2 {
    gap: 0.5rem;
  }
  /* ----- CSS chung cho cả 2 tab ----- */
  .account-sidebar .nav-link {
    color: #333;
    padding: 12px 15px;
    margin-bottom: 8px;
    border-radius: 8px;
    display: flex;
    align-items: center;
    font-weight: 500;
    cursor: pointer; /* Thêm con trỏ để cho biết có thể click */
  }

    /* Class 'active' của Bootstrap tab sẽ tự động xử lý việc highlight */
    .account-sidebar .nav-link.active,
    .account-sidebar .nav-link:hover {
      background-color: #f0f0f0;
      color: #0d6efd;
    }

    .account-sidebar .nav-link i {
      margin-right: 10px;
      width: 20px;
      text-align: center;
    }

  .logout-btn {
    width: 100%;
    border: 1px solid #ddd;
    font-weight: bold;
    color: #dc3545;
    background-color: white;
  }

  /* ----- CSS cho Tab Đơn hàng ----- */
  .order-status-filters .nav-link {
    color: #333;
    border: 1px solid #dee2e6;
    border-radius: 20px;
    margin-right: 10px;
    padding: 5px 15px;
    font-size: 0.9rem;
  }

    .order-status-filters .nav-link.active {
      background-color: white;
      color: #0d6efd;
      border-color: #0d6efd;
      font-weight: bold;
    }

  .empty-orders-container {
    text-align: center;
    padding: 80px 20px;
    background-color: #f8f9fa;
    border-radius: 8px;
  }

    .empty-orders-container .icon {
      font-size: 60px;
      color: #0d6efd;
      margin-bottom: 20px;
    }

    .empty-orders-container h4 {
      font-weight: bold;
    }

  /* ----- CSS cho Tab Thông tin ----- */
  .info-card {
    background-color: #fff;
    padding: 24px;
    border-radius: 8px;
    border: 1px solid #e9ecef;
    margin-bottom: 24px;
  }

  .info-card-header {
    font-weight: bold;
    text-transform: uppercase;
    margin-bottom: 16px;
  }

  .update-btn {
    background-color: #f57224;
    border-color: #f57224;
    color: white;
    font-weight: bold;
  }

  .cancel-save-links a {
    margin-left: 15px;
    font-weight: bold;
  }

  .form-select {
    color: #f57224;
  }

  #saveProfile {
    color: #198754; /* Màu xanh cho nút Lưu */
  }

  #cancelProfileEdit {
    color: #6c757d; /* Màu xám cho nút Hủy */
  }
</style>