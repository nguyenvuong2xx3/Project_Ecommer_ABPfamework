@using Acme.SimpleTaskApp.Web.Models.UserProfiles
@model UserProfileViewModel
@{
  ViewData["Title"] = "Index";
  Layout = "~/Views/Shared/Layout/Customer/_LayoutCustomer.cshtml";
}

@section scripts
{
  <environment names="Development">
    <script src="~/view-resources/Views/UserProfiles/Index.js" asp-append-version="true"></script>
  </environment>
}

<style>
  /* ----- CSS chung cho cả 2 tab ----- */
  .account-sidebar .nav-link {
    color: #333;
    padding: 12px 15px;
    margin-bottom: 8px;
    border-radius: 8px;
    display: flex;
    align-items: center;
    font-weight: 500;
    cursor: pointer; /* Thêm con trỏ để cho biết có thể click */
  }

    /* Class 'active' của Bootstrap tab sẽ tự động xử lý việc highlight */
    .account-sidebar .nav-link.active,
    .account-sidebar .nav-link:hover {
      background-color: #f0f0f0;
      color: #0d6efd;
    }

    .account-sidebar .nav-link i {
      margin-right: 10px;
      width: 20px;
      text-align: center;
    }

  .logout-btn {
    width: 100%;
    border: 1px solid #ddd;
    font-weight: bold;
    color: #dc3545;
    background-color: white;
  }

  /* ----- CSS cho Tab Đơn hàng ----- */
  .order-status-filters .nav-link {
    color: #333;
    border: 1px solid #dee2e6;
    border-radius: 20px;
    margin-right: 10px;
    padding: 5px 15px;
    font-size: 0.9rem;
  }

    .order-status-filters .nav-link.active {
      background-color: white;
      color: #0d6efd;
      border-color: #0d6efd;
      font-weight: bold;
    }

  .empty-orders-container {
    text-align: center;
    padding: 80px 20px;
    background-color: #f8f9fa;
    border-radius: 8px;
  }

    .empty-orders-container .icon {
      font-size: 60px;
      color: #0d6efd;
      margin-bottom: 20px;
    }

    .empty-orders-container h4 {
      font-weight: bold;
    }

  /* ----- CSS cho Tab Thông tin ----- */
  .info-card {
    background-color: #fff;
    padding: 24px;
    border-radius: 8px;
    border: 1px solid #e9ecef;
    margin-bottom: 24px;
  }

  .info-card-header {
    font-weight: bold;
    text-transform: uppercase;
    margin-bottom: 16px;
  }

  .update-btn {
    background-color: #f57224;
    border-color: #f57224;
    color: white;
    font-weight: bold;
  }

  .cancel-save-links a {
    margin-left: 15px;
    font-weight: bold;
  }

  .form-select {
    color: #f57224;
  }
</style>

<div class="container">
  <div class="row  pt-3">
    <div class="col-md-3">
      <div class="account-sidebar">
        <h4>Tên người dùng</h4>
        <ul class="nav flex-column" id="accountTab" role="tablist">
          <li class="nav-item" role="presentation">
            <a class="nav-link active" id="orders-tab" data-bs-toggle="tab" data-bs-target="#orders-tab-pane" role="tab" aria-controls="orders-tab-pane" aria-selected="true">
              <i class="fas fa-box"></i>
              Đơn hàng đã mua
            </a>
          </li>
          <li class="nav-item" role="presentation">
            <a class="nav-link" id="info-tab" data-bs-toggle="tab" data-bs-target="#info-tab-pane" role="tab" aria-controls="info-tab-pane" aria-selected="false">
              <i class="fas fa-map-marker-alt"></i>
              Thông tin và số địa chỉ
            </a>
          </li>
        </ul>
        <hr />
        <button class="btn logout-btn">Đăng Xuất</button>
      </div>
    </div>

    <!-- Cột bên phải (Nội dung các Tab) -->
    <div class="col-md-9">
      <!-- Thêm class "tab-content" để chứa các pane -->
      <div class="tab-content" id="accountTabContent">

        <!-- 1. Nội dung cho Tab "Đơn hàng đã mua" -->
        <!-- Thêm class "show active" để pane này hiển thị mặc định -->
        <div class="tab-pane fade show active" id="orders-tab-pane" role="tabpanel" aria-labelledby="orders-tab">
          <div class="d-flex justify-content-between align-items-center mb-3">
            <h4 class="mb-0">Đơn hàng đã mua</h4>
            <div>
              <div class="d-flex">
                <label for="StartEndRange" class="form-label" style="width: 200px">Thời gian đặt hàng</label>
                <input id="StartEndRange" autocomplete="off" type="text" class="form-control date-range-picker" placeholder="@L("fromTo")" name="Thời gian đặt hàng" />
              </div>
            </div>
          </div>
          <ul class="nav nav-pills mb-4 order-status-filters">
            <li class="nav-item"><a href="#" class="nav-link">Tất cả</a></li>
            <li class="nav-item"><a href="#" class="nav-link active">Thành công</a></li>
            @* ... các bộ lọc khác ... *@
          </ul>
          <div class="empty-orders-container">
            <div class="icon"><i class="fas fa-shopping-bag"></i></div>
            <h4>Rất tiếc, không tìm thấy đơn hàng nào phù hợp</h4>
            <p class="text-muted">Vẫn còn rất nhiều sản phẩm đang chờ anh</p>
            <div>
              <a href="#" class="btn btn-outline-primary">Điện thoại</a>
              <a href="#" class="btn btn-outline-primary">Laptop</a>
            </div>
            <div class="mt-4">
              <a href="/"><i class="fas fa-chevron-left"></i> Về trang chủ</a>
            </div>
          </div>
        </div>

        <!-- 2. Nội dung cho Tab "Thông tin và số địa chỉ" -->
        <div class="tab-pane fade" id="info-tab-pane" role="tabpanel" aria-labelledby="info-tab">
          <h3 class="mb-4 fw-bold">Thông tin tài khoản</h3>
          <div class="info-card">
            <h5 class="info-card-header">Thông tin cá nhân</h5>
            <p>@Model.User.FullName</p>
            <form>
              <div class="mb-3">
                <div class="form-check form-check-inline">
                  <input class="form-check-input" type="radio" name="gender" id="genderMale" checked>
                  <label class="form-check-label" for="genderMale">Anh</label>
                </div>
                <div class="form-check form-check-inline">
                  <input class="form-check-input" type="radio" name="gender" id="genderFemale">
                  <label class="form-check-label" for="genderFemale">Chị</label>
                </div>
              </div>
              <div class="row align-items-end">
                <div class="col-md-5 mb-3">
                  <label for="fullName" class="form-label">Họ & Tên:</label>
                  <input type="text" class="form-control" id="fullName" value="@Model.User.FullName">
                </div>
                <div class="col-md-5 mb-3">
                  <label for="phoneNumber" class="form-label">Số điện thoại:</label>
                  <input type="text" class="form-control" id="phoneNumber" value="@Model.User.PhoneNumber">
                </div>
                <div class="col-md-2 mb-3 text-end cancel-save-links">
                  <a href="#" class="text-decoration-none">Hủy</a>
                  <a href="#" class="text-decoration-none">Lưu</a>
                </div>
              </div>
            </form>
          </div>
          <div class="info-card">
            <h5 class="info-card-header">Địa chỉ nhận hàng</h5>
            <form>
              <div class="row">
                <div class="col-md-6 mb-3">
                  <select class="form-select" id="province">
                    <option selected>Chọn Tỉnh/Thành phố</option>
                  </select>
                </div>
                <div class="col-md-6 mb-3">
                  <select class="form-select" id="ward">
                    <option selected>Chọn Phường/Xã</option>
                  </select>
                </div>
              </div>
              <div class="mb-3">
                <input type="text" class="form-control" placeholder="Số Nhà, Tên Đường*">
              </div>
              <div class="form-check mb-4">
                <input class="form-check-input" type="checkbox" id="defaultAddressCheck">
                <label class="form-check-label" for="defaultAddressCheck">Đặt làm địa chỉ mặc định</label>
              </div>
              <button type="submit" class="btn update-btn">CẬP NHẬT</button>
            </form>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>